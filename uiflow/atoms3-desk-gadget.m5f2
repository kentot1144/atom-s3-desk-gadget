{"version":"V2.0","versionNumber":"V2.5.4","type":"atoms3","components":[],"resources":[],"units":[],"hats":[],"caps":[],"chains":[],"bases":[],"plcmodules":[],"stamps":[],"tab5modules":[],"poep4modules":[],"i2cs":[],"chainBus":[],"blockly":"<variables></variables><block type=\"basic_on_setup\" id=\"setup_block\" deletable=\"false\" x=\"50\" y=\"50\"><mutation isBegin=\"true\"></mutation><field name=\"UPDATEOP\">true</field><statement name=\"FUNC\"><block type=\"system_m5_begin\" id=\"system_m5_begin\"></block></statement></block><block type=\"basic_on_loop\" id=\"loop_block\" deletable=\"false\" x=\"70\" y=\"270\"><mutation isUpdate=\"true\"></mutation><field name=\"UPDATEOP\">true</field><statement name=\"FUNC\"><block type=\"system_m5_update\" id=\"system_m5_update\"></block></statement></block>","screen":[{"simulationName":"Built-in","type":"builtin","width":128,"height":128,"scale":1,"screenName":"","blockId":"","screenColorType":0,"id":"builtin","createTime":1794973463240}],"logicWhenNum":0,"pythonCode":"\"\"\"AtomS3 Desk Gadget - UIFlow2 Python-mode launcher.\n\nWrites the split desk modules to flash, then starts the normal app boot.\nSafe to share: only placeholder config is embedded (config.json.example).\nAfter importing, edit /flash/config.json in the UIFlow file manager.\n\"\"\"\nimport gc\nimport os\nimport sys\nimport time\nimport network\n\n# Grab the radio while the heap is still fresh, just like the original boot.\ngc.collect()\nwlan = network.WLAN(network.STA_IF)\n\ntry:\n    os.stat(\"/flash\")\n    base = \"/flash\"\nexcept OSError:\n    base = \"\"\n\n\ndef _mk(path):\n    d = base\n    for part in path.split(\"/\")[:-1]:\n        d = (d + \"/\" + part) if d else part\n        try:\n            os.stat(d)\n        except OSError:\n            try:\n                os.mkdir(d)\n            except OSError:\n                pass\n\n\ndef _w(path, data, only_if_missing=False):\n    full = (base + \"/\" + path) if base else path\n    if only_if_missing:\n        try:\n            os.stat(full)\n            return\n        except OSError:\n            pass\n    _mk(path)\n    f = open(full, \"w\")\n    try:\n        f.write(data)\n    finally:\n        f.close()\n\n_w(\"config.json\", \"{\\n  \\\"wifi\\\": [\\n    { \\\"ssid\\\": \\\"YOUR_WIFI_SSID\\\", \\\"password\\\": \\\"YOUR_WIFI_PASSWORD\\\" },\\n    { \\\"ssid\\\": \\\"YOUR_HOTSPOT_SSID\\\", \\\"password\\\": \\\"YOUR_HOTSPOT_PASSWORD\\\" }\\n  ],\\n  \\\"location\\\": { \\\"lat\\\": 0.0, \\\"lon\\\": 0.0, \\\"tz\\\": 0, \\\"name\\\": \\\"Your City\\\" },\\n  \\\"hub\\\": {\\n    \\\"urls\\\": [\\\"http://192.168.1.10:8765\\\", \\\"http://YOUR_SECOND_HUB_HOST:8765\\\"],\\n    \\\"mac\\\": \\\"\\\",\\n    \\\"token\\\": \\\"\\\",\\n    \\\"discovery_port\\\": 8766\\n  },\\n  \\\"display\\\": {\\n    \\\"brightness\\\": 120,\\n    \\\"auto\\\": true,\\n    \\\"light_pin\\\": 6,\\n    \\\"min\\\": 25,\\n    \\\"max\\\": 200,\\n    \\\"interval\\\": 2000\\n  },\\n  \\\"alerts\\\": {\\n    \\\"blink\\\": true,\\n    \\\"led_gpio\\\": 5,\\n    \\\"backlight\\\": false,\\n    \\\"rgb_gpio\\\": 0\\n  },\\n  \\\"pomodoro\\\": { \\\"focus\\\": 25, \\\"break\\\": 5 }\\n}\\n\", True)\n_w(\"app.py\", \"\\\"\\\"\\\"Entry point for main.py.\\n\\nThe real code lives in the `desk` package.  It is split into small modules\\nbecause MicroPython has to compile a file before running it, and 2.3.1 only\\nhas ~112 KB of heap at boot - a single 64 KB app.py cannot be compiled there.\\n\\\"\\\"\\\"\\nfrom desk.app import run\\n\\n__all__ = (\\\"run\\\",)\\n\")\n_w(\"desk/__init__.py\", \"\\\"\\\"\\\"AtomS3 desk gadget, split so each module fits the small heap.\\\"\\\"\\\"\\n\")\n_w(\"desk/app.py\", \"\\\"\\\"\\\"Thin display client: wires the modules together and owns app state.\\\"\\\"\\\"\\nimport M5\\nimport gc\\nimport time\\nfrom desk.const import FALLBACK, SYS_PAGE\\nfrom desk.hub import Hub\\nfrom desk.pom import Led, Light, Pomodoro\\nfrom desk.spot import Spot\\nfrom desk.wifi import Wifi, load_cfg\\n\\nfrom desk.draw import AppDraw\\nfrom desk.loop import AppLoop\\n\\n\\nclass App(AppDraw, AppLoop):\\n    def __init__(self, wlan, cfg):\\n        self.cfg = cfg\\n        self.tz = int((cfg.get(\\\"location\\\") or {}).get(\\\"tz\\\", 9))\\n        self.wifi = Wifi(wlan, cfg)\\n        self.hub = Hub(wlan, cfg)\\n        self.pom = Pomodoro(cfg)\\n        self.light = Light(cfg)\\n        self.led = Led(self.light.value, cfg)\\n        self.spot = Spot(self)\\n\\n        self.mode = 0\\n        self.idx = 0\\n        self.ui = None\\n        self.last_ui = None\\n        self._ring = None\\n        self._ring_src = None\\n        self.dirty = True\\n        self.clk_sec = -1\\n        self.focus_at = 0\\n        self.face_at = 0\\n        self.status_at = 0\\n        self.started = time.ticks_ms()\\n        self.connected_at = 0\\n        self.ntp_done = False\\n\\n        self.banners = []\\n        self.banner = None\\n        self.banner_at = 0\\n        self.banner_dirty = False\\n\\n        # Auto-advancing rows sub-pages (servers page).\\n        self.rs_page = 0\\n        self.rs_at = 0\\n\\n        # Status sub-pages: 0 = system health, 1 = bare Spotify state.\\n        self.st_page = 0\\n        self.st_at = 0\\n\\n        self.face = {\\\"breath\\\": 0, \\\"dev\\\": 0, \\\"tm\\\": 0, \\\"st\\\": 0, \\\"open\\\": 3000}\\n        self.rst = {\\\"state\\\": \\\"idle\\\", \\\"msg\\\": \\\"\\\", \\\"at\\\": 0, \\\"sent\\\": 0,\\n                    \\\"dots\\\": 0, \\\"check_at\\\": 0, \\\"checks\\\": 0, \\\"good\\\": 0,\\n                    \\\"prog\\\": -1, \\\"song\\\": \\\"\\\"}\\n        self.bright = self.light.value\\n\\n        self.down = False\\n        self.press_at = 0\\n        self.hold_done = False\\n        self.soft_done = False\\n        self.clicks = []\\n\\n    # -- helpers -----------------------------------------------------\\n    def now(self):\\n        return self.hub.now()\\n\\n    def local(self):\\n        return time.localtime(self.now() + self.tz * 3600)\\n\\n    def alert(self):\\n        return bool((self.ui or {}).get(\\\"al\\\"))\\n\\n    def page_list(self):\\n        u = self.ui or {}\\n        if self.mode == 1:\\n            return u.get(\\\"spot\\\") or [{\\\"k\\\": \\\"spotify\\\", \\\"t\\\": \\\"SPOTIFY\\\"}]\\n        ring = u.get(\\\"norm\\\")\\n        if not ring:\\n            return FALLBACK\\n        if ring is not self._ring_src:\\n            # Copy so the hub dict is never mutated; cache so the ring is not\\n            # rebuilt on every draw call.\\n            self._ring_src = ring\\n            r = list(ring)\\n            r.append(SYS_PAGE)\\n            self._ring = r\\n        return self._ring\\n\\n    def page(self):\\n        pages = self.page_list()\\n        if self.idx >= len(pages):\\n            self.idx = 0\\n        return pages[self.idx]\\n\\n    def enter_page(self):\\n        self.dirty = True\\n        self.clk_sec = -1\\n        self.focus_at = 0\\n        self.face_at = 0\\n        self.status_at = 0\\n        self.rs_page = 0\\n        self.rs_at = time.ticks_ms()\\n        self.st_page = 0\\n        self.st_at = time.ticks_ms()\\n        p = self.page()\\n        if p.get(\\\"k\\\") == \\\"spotify\\\":\\n            self.spot.enter()\\n        elif p.get(\\\"k\\\") == \\\"restart\\\":\\n            self.rst[\\\"state\\\"] = \\\"idle\\\"\\n            self.rst[\\\"msg\\\"] = \\\"\\\"\\n\\n    def next_page(self):\\n        n = len(self.page_list())\\n        self.idx = (self.idx + 1) % n\\n        self.enter_page()\\n\\n    def switch_mode(self):\\n        self.mode = 1 - self.mode\\n        self.idx = 0\\n        self.banner = None\\n        self.clicks = []\\n        self.hold_done = True\\n        self.enter_page()\\n\\n    # -- drawing -----------------------------------------------------\\n    def draw(self, p=None):\\n        if p is None:\\n            p = self.page()\\n        k = p.get(\\\"k\\\")\\n        if k == \\\"clock\\\":\\n            self.draw_clock(p)\\n        elif k == \\\"big\\\":\\n            self.draw_big(p)\\n        elif k == \\\"rows\\\":\\n            self.draw_rows(p)\\n        elif k == \\\"focus\\\":\\n            self.draw_focus(p)\\n        elif k == \\\"restart\\\":\\n            self.draw_restart(p)\\n        elif k == \\\"face\\\":\\n            self.draw_face(p)\\n        elif k == \\\"notice\\\":\\n            self.draw_notice(p)\\n        elif k == \\\"status\\\":\\n            self.draw_status(p)\\n        elif k == \\\"spotify\\\":\\n            self.spot.dirty_full = True\\n            self.spot.draw()\\n        else:\\n            self.draw_msg(p)\\n\\n\\ndef run(wlan):\\n    gc.collect()\\n    cfg = load_cfg()\\n    M5.begin()\\n    gc.collect()\\n    print(\\\"app free\\\", gc.mem_free())\\n    app = App(wlan, cfg)\\n    app.run()\\n\")\n_w(\"desk/const.py\", \"\\\"\\\"\\\"Shared constants for the thin display client.\\\"\\\"\\\"\\n\\nHUB_TIMEOUT_S = 1.5\\nHUB_BAD_MS = 15000\\nHUB_POLL_MS = 3000\\nHUB_POLL_LIVE_MS = 1000\\nROAM_AFTER_MS = 180000\\nHOME_AFTER_MS = 45000\\nNTP_FALLBACK_MS = 15000\\n\\n# Local page the hub cannot override, so Wi-Fi / hub health is always visible.\\nSYS_PAGE = {\\\"k\\\": \\\"sys\\\", \\\"t\\\": \\\"DEVICE\\\"}\\nFALLBACK = [{\\\"k\\\": \\\"clock\\\"}, {\\\"k\\\": \\\"focus\\\", \\\"t\\\": \\\"FOCUS\\\"}, SYS_PAGE]\\n\\n# ---------------------------------------------------------------------- app\\nHOLD_MS = 3000\\nSOFT_HOLD_MS = 1000\\nCLICK_GAP_MS = 400\\nNOTIF_SHOW_MS = 9000\\nNOTIF_MAX_AGE_S = 300\\n\\n# Auto-advancing rows page (servers): one sub-page at a time, then wrap.\\nROWS_PAGE_MS = 3600\\n\\n# Status alternates between system health and the bare Spotify state.\\nSTATUS_PAGE_MS = 5000\\n\")\n_w(\"desk/draw.py\", \"\\\"\\\"\\\"Page renderers for the hub-driven pages.\\\"\\\"\\\"\\nimport M5\\nimport gc\\nimport sys\\nimport time\\nfrom desk.ui import ACCENT, ACCENT2, AMBER, BLACK, F_BIG, F_MD, F_SM, F_TINY, GREEN, LCD, LINE, MON, MUTED, ORANGE, PANEL, PURPLE, RED, W, WD, WHITE, age_text, atom_face, bar, ctemp, ctext, dots, header, mmss, pc, rtemp, rtext, seg_time, t1, temp, tl, wrap\\n\\nclass AppDraw:\\n    def _head(self, p, color=None, title=None):\\n        n = len(self.page_list())\\n        header((p.get(\\\"t\\\") or \\\"\\\") if title is None else title, self.idx, n,\\n               pc(p.get(\\\"hc\\\")) if color is None and p.get(\\\"hc\\\") is not None\\n               else (color or ACCENT))\\n        dots(n, self.idx)\\n\\n    def draw_clock(self, p):\\n        LCD.fillScreen(BLACK)\\n        t = self.local()\\n        ctext(\\\"%s %02d %s\\\" % (WD[t[6]], t[2], MON[t[1] - 1]), F_SM, 6, MUTED)\\n        seg_time(\\\"%02d%02d\\\" % (t[3], t[4]), 24, WHITE)\\n        LCD.fillRect(14, 76, 100, 3, LINE)\\n        if t[5] > 0:\\n            LCD.fillRect(14, 76, t[5] * 100 // 60, 3, ACCENT)\\n        if p.get(\\\"temp\\\") is not None:\\n            temp(\\\"%d\\\" % int(p[\\\"temp\\\"]), F_MD, 14, 88, AMBER)\\n        else:\\n            tl(\\\"--\\\", F_MD, 14, 88, LINE)\\n        if self.wifi.up():\\n            if p.get(\\\"al\\\"):\\n                rtext(\\\"ALERT\\\", F_SM, 120, 90, RED)\\n            else:\\n                rtext(\\\"ONLINE\\\", F_SM, 120, 90, GREEN)\\n        else:\\n            rtext(\\\"NO WIFI\\\", F_SM, 120, 90, RED)\\n        cal = p.get(\\\"cal\\\") or \\\"\\\"\\n        if cal:\\n            t1(cal[:25], F_TINY, 4, 109, ACCENT2)\\n        dots(len(self.page_list()), self.idx)\\n        self.clk_sec = t[5]\\n\\n    def draw_big(self, p):\\n        LCD.fillScreen(BLACK)\\n        self._head(p)\\n        ctemp(p.get(\\\"v\\\", \\\"--\\\"), F_BIG, 34, WHITE, r=3)\\n        ctext(p.get(\\\"cond\\\", \\\"\\\"), F_MD, 84, ACCENT)\\n        ctext(p.get(\\\"sub\\\", \\\"\\\"), F_SM, 106, MUTED)\\n\\n    # Rows pages: four entries fit, and an \\\"auto\\\" page with more entries is\\n    # split into sub-pages that the app loop advances on a timer.\\n    ROWS_PER = 4\\n    ROW_Y0 = 28\\n    ROW_PITCH = 22\\n\\n    def _row(self, r, y):\\n        if r.get(\\\"d\\\") is not None:\\n            LCD.fillRect(5, y + 3, 5, 5, pc(r[\\\"d\\\"], GREEN))\\n            x = 14\\n        else:\\n            x = 4\\n        tl(r.get(\\\"l\\\", \\\"\\\"), F_SM, x, y, pc(r.get(\\\"c\\\")))\\n        v = r.get(\\\"v\\\") or \\\"\\\"\\n        if v:\\n            if r.get(\\\"deg\\\"):\\n                rtemp(v, F_SM, 124, y, pc(r.get(\\\"vc\\\"), ORANGE))\\n            elif len(v) > 5:\\n                rtext(v, F_TINY, 123, y + 2, pc(r.get(\\\"vc\\\")))\\n            else:\\n                rtext(v, F_SM, 123, y, pc(r.get(\\\"vc\\\")))\\n        if r.get(\\\"p\\\") is not None:\\n            bar(34, y + 3, 56, 7, r[\\\"p\\\"], pc(r.get(\\\"pc\\\"), GREEN))\\n        s = r.get(\\\"s\\\")\\n        if s:\\n            tl(s, F_TINY, 14, y + 13, pc(r.get(\\\"sc\\\"), MUTED))\\n\\n    def rows_pages(self, p):\\n        n = len(p.get(\\\"rows\\\") or [])\\n        if not p.get(\\\"auto\\\") or n <= self.ROWS_PER:\\n            return 1\\n        return (n + self.ROWS_PER - 1) // self.ROWS_PER\\n\\n    def draw_rows(self, p):\\n        rows = p.get(\\\"rows\\\") or []\\n        npages = self.rows_pages(p)\\n        i = (self.rs_page % npages) if npages > 1 else 0\\n        LCD.fillScreen(BLACK)\\n        if npages > 1:\\n            chunk = rows[i * self.ROWS_PER:(i + 1) * self.ROWS_PER]\\n        else:\\n            chunk = rows\\n        y = self.ROW_Y0\\n        for r in chunk:\\n            if y > 104:\\n                break\\n            self._row(r, y)\\n            y += self.ROW_PITCH\\n        if npages > 1:\\n            # The page ring already shows SERVERS as one page, so the\\n            # sub-page counter belongs in the title.\\n            header(\\\"%s %d/%d\\\" % (p.get(\\\"t\\\") or \\\"ROWS\\\", i + 1, npages),\\n                   self.idx, len(self.page_list()),\\n                   pc(p.get(\\\"hc\\\")) if p.get(\\\"hc\\\") is not None else ACCENT)\\n            dots(len(self.page_list()), self.idx)\\n        else:\\n            self._head(p)\\n        if p.get(\\\"foot\\\"):\\n            ctext(p[\\\"foot\\\"], F_TINY, 107, pc(p.get(\\\"fc\\\"), MUTED))\\n\\n    def draw_msg(self, p):\\n        LCD.fillScreen(BLACK)\\n        self._head(p)\\n        ctext((p.get(\\\"m\\\") or \\\"\\\")[:22], F_SM, 58, MUTED)\\n        if p.get(\\\"m2\\\"):\\n            ctext((p.get(\\\"m2\\\") or \\\"\\\")[:22], F_TINY, 76, LINE)\\n\\n    def draw_focus(self, p):\\n        LCD.fillScreen(BLACK)\\n        self._head(p)\\n        q = self.pom\\n        if q.mode == \\\"focus\\\":\\n            c, label = RED, \\\"FOCUS\\\"\\n        else:\\n            c, label = GREEN, \\\"BREAK\\\"\\n        ctext(label, F_SM, 28, c)\\n        rem = max(0, q.rem)\\n        seg_time(\\\"%02d%02d\\\" % (rem // 60000, (rem % 60000) // 1000),\\n                 42, WHITE)\\n        total = q.focus if q.mode == \\\"focus\\\" else q.brk\\n        bar(14, 94, 100, 5, rem * 100 // total if total else 0, c)\\n        ctext(\\\"2x CLICK PAUSE\\\" if q.running else \\\"2x CLICK START\\\",\\n              F_TINY, 104, MUTED)\\n        rtext(\\\"S%d\\\" % q.sessions, F_TINY, 122, 28, MUTED)\\n        self.focus_at = time.ticks_ms()\\n\\n    def draw_restart(self, p):\\n        LCD.fillScreen(BLACK)\\n        self._head(p, PURPLE)\\n        r = self.rst\\n        st = r[\\\"state\\\"]\\n        c = GREEN if st == \\\"busy\\\" else (\\n            RED if st in (\\\"error\\\", \\\"notsynced\\\") else ACCENT2)\\n        LCD.fillCircle(64, 46, 19, c)\\n        LCD.fillTriangle(58, 35, 58, 57, 76, 46, BLACK)\\n        ctext(\\\"SPOTIFY\\\", F_SM, 70, WHITE)\\n        if st == \\\"busy\\\":\\n            ctext(\\\"RESTARTING\\\" + \\\".\\\" * r[\\\"dots\\\"], F_TINY, 90, AMBER)\\n            ctext(\\\"on the hub PC\\\", F_TINY, 104, LINE)\\n        elif st == \\\"check\\\":\\n            ctext(\\\"VERIFYING\\\" + \\\".\\\" * r[\\\"dots\\\"], F_TINY, 90, AMBER)\\n            ctext(\\\"playback is live\\\", F_TINY, 104, LINE)\\n        elif st == \\\"done\\\":\\n            ctext(\\\"SYNCED\\\", F_SM, 90, GREEN)\\n            ctext(\\\"spotify is playing\\\", F_TINY, 106, MUTED)\\n        elif st == \\\"notsynced\\\":\\n            ctext(\\\"NOT SYNCED\\\", F_SM, 90, RED)\\n            ctext(\\\"double click retry\\\", F_TINY, 106, LINE)\\n        elif st == \\\"error\\\":\\n            ctext(r[\\\"msg\\\"], F_TINY, 90, RED)\\n            ctext(\\\"try again\\\", F_TINY, 104, LINE)\\n        else:\\n            ctext(\\\"DOUBLE CLICK\\\", F_TINY, 88, MUTED)\\n            ctext(\\\"to restart\\\", F_TINY, 102, LINE)\\n        dots(len(self.page_list()), self.idx)\\n\\n    def draw_face(self, p):\\n        LCD.fillScreen(BLACK)\\n        self._head(p, RED if p.get(\\\"al\\\") else ACCENT)\\n        f = self.face\\n        try:\\n            ax, _ay, _az = M5.Imu.getAccel()\\n        except Exception:\\n            ax = 0.0\\n        if ax > 0.35:\\n            mood, label, c = \\\"happy\\\", \\\"HAPPY\\\", AMBER\\n        elif ax < -0.35:\\n            mood, label, c = \\\"sleep\\\", \\\"SLEEPY\\\", PURPLE\\n        else:\\n            mood, label, c = \\\"normal\\\", \\\"CHILL\\\", ACCENT\\n        if mood != \\\"sleep\\\" and f[\\\"st\\\"] == 0:\\n            mood = \\\"blink\\\"\\n        if p.get(\\\"al\\\"):\\n            label, c = \\\"ALERT\\\", RED\\n        atom_face(mood, f[\\\"dev\\\"], bool(p.get(\\\"al\\\")))\\n        ctext(label, F_TINY, 107, c)\\n        dots(len(self.page_list()), self.idx)\\n\\n    def draw_notice(self, p):\\n        LCD.fillScreen(BLACK)\\n        self._head(p, ACCENT2)\\n        rows = p.get(\\\"rows\\\") or []\\n        if not rows:\\n            ctext(\\\"NO NOTICES\\\", F_SM, 52, MUTED)\\n            ctext(\\\"hub events appear here\\\", F_TINY, 72, LINE)\\n        else:\\n            y = 25\\n            for r in rows:\\n                LCD.fillRect(4, y + 3, 4, 4, pc(r.get(\\\"d\\\"), ACCENT))\\n                t1(r.get(\\\"l\\\", \\\"\\\"), F_SM, 12, y, pc(r.get(\\\"c\\\")))\\n                t1(r.get(\\\"s\\\", \\\"\\\"), F_TINY, 12, y + 12, MUTED)\\n                y += 24\\n            if p.get(\\\"more\\\"):\\n                tl(\\\"+%d MORE\\\" % p[\\\"more\\\"], F_TINY, 6, 99, MUTED)\\n        ctext(\\\"HUB EVENT LOG\\\", F_TINY, 110, LINE)\\n        dots(len(self.page_list()), self.idx)\\n\\n    def draw_status(self, p):\\n        \\\"\\\"\\\"Status alternates: system health, then the bare Spotify state.\\\"\\\"\\\"\\n        st = int(getattr(self, \\\"st_page\\\", 0))\\n        title = \\\"STATUS %d/2\\\" % (st + 1)\\n        if st:\\n            self._draw_status_spot(p, title)\\n        else:\\n            self._draw_status_sys(p, title)\\n\\n    def _draw_status_sys(self, p, title):\\n        LCD.fillScreen(BLACK)\\n        self._head(p, RED if self.alert() else ACCENT, title)\\n        ip, rssi = \\\"-\\\", 0\\n        if self.wifi.up():\\n            try:\\n                ip = self.wifi.wlan.ifconfig()[0]\\n            except Exception:\\n                ip = \\\"?\\\"\\n            try:\\n                rssi = self.wifi.wlan.status(\\\"rssi\\\")\\n            except Exception:\\n                rssi = 0\\n        gc.collect()\\n        free = gc.mem_free() // 1024\\n        up = time.ticks_diff(time.ticks_ms(), self.started) // 1000\\n        rows = ((\\\"IP\\\", ip), (\\\"RSSI\\\", \\\"%d dBm\\\" % rssi),\\n                (\\\"HEAP\\\", \\\"%d KB\\\" % free),\\n                (\\\"UPTIME\\\", \\\"%dd %02dh %02dm\\\" % (\\n                    up // 86400, (up % 86400) // 3600,\\n                    (up % 3600) // 60)),\\n                (\\\"LIGHT\\\", \\\"%d%%  B%d\\\" % (self.light.pct, self.bright)))\\n        y = 23\\n        for name, val in rows:\\n            tl(name, F_TINY, 6, y, MUTED)\\n            rtext(val, F_SM, 122, y - 1, WHITE)\\n            y += 12\\n        upn = int(p.get(\\\"up\\\") or 0)\\n        tot = int(p.get(\\\"tot\\\") or 0)\\n        tl(\\\"SVC\\\", F_TINY, 6, 86, MUTED)\\n        rtext(\\\"%d/%d UP\\\" % (upn, tot), F_SM, 122, 85,\\n              GREEN if upn == tot else AMBER)\\n        last = int(p.get(\\\"last\\\") or 0)\\n        if last:\\n            ago = max(0, self.now() - last)\\n            tl((\\\"DOWN %s AGO\\\" % age_text(ago))[:21], F_TINY, 6, 100,\\n               RED if upn < tot else AMBER)\\n        else:\\n            tl(\\\"NO DOWNTIME\\\", F_TINY, 6, 100, GREEN)\\n        tl(\\\"HUB\\\", F_TINY, 6, 110, MUTED)\\n        if self.hub.fresh(15000):\\n            txt, c = \\\"OK\\\", GREEN\\n        elif self.hub.ui:\\n            txt, c = \\\"STALE\\\", AMBER\\n        else:\\n            txt, c = (self.hub.err or \\\"OFFLINE\\\")[:10], RED\\n        rtext(txt, F_TINY, 122, 110, c)\\n        dots(len(self.page_list()), self.idx)\\n        self.status_at = time.ticks_ms()\\n\\n    def _draw_status_spot(self, p, title):\\n        \\\"\\\"\\\"Bare Spotify state: what is playing and how far in.\\\"\\\"\\\"\\n        LCD.fillScreen(BLACK)\\n        sp = self.hub.sp or {}\\n        fresh = self.hub.fresh(15000)\\n        playing = self.hub.playing()\\n        status = sp.get(\\\"status\\\")\\n        if not fresh:\\n            label, col = \\\"HUB OFFLINE\\\", RED\\n        elif status == \\\"success\\\":\\n            label, col = (\\\"PLAYING\\\", GREEN) if playing else (\\\"PAUSED\\\", AMBER)\\n        elif status == \\\"not_playing\\\":\\n            label, col = \\\"STOPPED\\\", MUTED\\n        elif status == \\\"connecting\\\":\\n            label, col = \\\"CONNECTING\\\", ACCENT\\n        else:\\n            label, col = \\\"NO MUSIC\\\", MUTED\\n        self._head(p, RED if self.alert() else ACCENT, title)\\n        ctext(label, F_MD, 23, col)\\n        song = sp.get(\\\"song\\\") or \\\"-\\\"\\n        artist = sp.get(\\\"artist\\\") or \\\"-\\\"\\n        device = sp.get(\\\"device\\\") or \\\"-\\\"\\n        if song == \\\"-\\\":\\n            ctext(\\\"NO TRACK\\\", F_SM, 45, MUTED)\\n        else:\\n            for i, line in enumerate(wrap(song, F_SM, 116, 2)):\\n                t1(line, F_SM, 6, 44 + i * 14, WHITE)\\n        tl((artist if artist != \\\"-\\\" else \\\"UNKNOWN ARTIST\\\")[:21],\\n           F_TINY, 6, 74, MUTED)\\n        tl((\\\"ON \\\" + (device if device != \\\"-\\\" else \\\"--\\\"))[:21],\\n           F_TINY, 6, 86, ACCENT)\\n        pos = self.hub.progress()\\n        dur = int(sp.get(\\\"duration_ms\\\") or 0)\\n        pct = int(pos * 100 / dur) if dur else 0\\n        bar(6, 98, 116, 5, pct, GREEN if playing else AMBER)\\n        tl(mmss(pos), F_TINY, 6, 106, MUTED)\\n        rtext(mmss(dur) if dur else \\\"--:--\\\", F_TINY, 122, 106, MUTED)\\n        dots(len(self.page_list()), self.idx)\\n        self.status_at = time.ticks_ms()\\n\\n    def draw_sys(self, p):\\n        \\\"\\\"\\\"Local health page.  Renders even if the hub never answered.\\\"\\\"\\\"\\n        LCD.fillScreen(BLACK)\\n        self._head(p, RED if self.alert() else ACCENT)\\n        up = self.wifi.up()\\n        ip = \\\"-\\\"\\n        rssi = 0\\n        if up:\\n            try:\\n                ip = self.wifi.wlan.ifconfig()[0]\\n            except Exception:\\n                ip = \\\"?\\\"\\n            try:\\n                rssi = int(self.wifi.wlan.status(\\\"rssi\\\"))\\n            except Exception:\\n                rssi = 0\\n            if rssi > -67:\\n                rc = GREEN\\n            elif rssi > -75:\\n                rc = AMBER\\n            else:\\n                rc = RED\\n            rtxt = \\\"%d dBm\\\" % rssi\\n        else:\\n            rc = RED\\n            rtxt = \\\"--\\\"\\n        age = self.hub.age()\\n        if self.hub.fresh(15000):\\n            htxt, hc = \\\"OK %s\\\" % age_text(age), GREEN\\n        elif self.hub.ui:\\n            htxt, hc = \\\"STALE %s\\\" % age_text(age), AMBER\\n        else:\\n            htxt, hc = (self.hub.err or \\\"OFFLINE\\\")[:12], RED\\n        secs = time.ticks_diff(time.ticks_ms(), self.started) // 1000\\n        try:\\n            v = sys.implementation.version\\n            fw = \\\"%d.%d.%d\\\" % (v[0], v[1], v[2])\\n        except Exception:\\n            fw = \\\"?\\\"\\n        rows = (\\n            (\\\"WIFI\\\", (self.wifi.ssid or \\\"-\\\")[:16], GREEN if up else RED,\\n             F_TINY),\\n            (\\\"IP\\\", ip, WHITE, F_SM),\\n            (\\\"RSSI\\\", rtxt, rc, F_SM),\\n            (\\\"HUB\\\", htxt, hc, F_SM),\\n            (\\\"HEAP\\\", \\\"%d KB\\\" % (gc.mem_free() // 1024), WHITE, F_SM),\\n            (\\\"UP\\\", \\\"%dd %02dh %02dm\\\" % (secs // 86400,\\n                                        (secs % 86400) // 3600,\\n                                        (secs % 3600) // 60), WHITE, F_SM),\\n            (\\\"FW\\\", fw, MUTED, F_SM),\\n        )\\n        y = 22\\n        for name, val, col, fnt in rows:\\n            tl(name, F_TINY, 6, y + 1, MUTED)\\n            rtext(val, fnt, 122, y, col)\\n            y += 12\\n        tl(\\\"2x CLICK = POLL\\\", F_TINY, 6, 108, LINE)\\n        self.status_at = time.ticks_ms()\\n\\n    def draw_banner(self):\\n        ev = self.banner\\n        if not ev:\\n            return\\n        kind = ev.get(\\\"kind\\\") or \\\"\\\"\\n        c = (GREEN if kind == \\\"mc_join\\\" else RED if kind == \\\"mc_leave\\\"\\n             else AMBER if kind == \\\"mc_move\\\" else ACCENT)\\n        LCD.fillScreen(PANEL)\\n        LCD.fillRect(0, 0, W, 3, c)\\n        t1((\\\"NEW \\\" + kind.upper().replace(\\\"_\\\", \\\" \\\"))[:20],\\n           F_TINY, 6, 7, c)\\n        ts = int(ev.get(\\\"ts\\\") or 0)\\n        if ts:\\n            t = time.localtime(ts + self.tz * 3600)\\n            rtext(\\\"%02d:%02d\\\" % (t[3], t[4]), F_TINY, 122, 7, MUTED)\\n        ty = 24\\n        for line in wrap(str(ev.get(\\\"title\\\") or \\\"NOTICE\\\"), F_MD, 116, 2):\\n            ctext(line, F_MD, ty, WHITE)\\n            ty += 23\\n        by = ty + 2\\n        for line in wrap(str(ev.get(\\\"body\\\") or \\\"\\\"), F_SM, 116, 2):\\n            t1(line, F_SM, 6, by, MUTED)\\n            by += 14\\n        ctext(\\\"CLICK TO DISMISS\\\", F_TINY, 113, LINE)\\n\")\n_w(\"desk/hub.py\", \"\\\"\\\"\\\"Hub polling over plain HTTP with DNS caching and target failover.\\\"\\\"\\\"\\nimport json\\nimport socket\\nimport time\\nfrom desk.const import HUB_BAD_MS, HUB_TIMEOUT_S\\n\\n# ---------------------------------------------------------------------- hub\\n_dns = {}\\n\\n\\ndef _is_ipv4(host):\\n    parts = host.split(\\\".\\\")\\n    if len(parts) != 4:\\n        return False\\n    for p in parts:\\n        if not p.isdigit() or int(p) > 255:\\n            return False\\n    return True\\n\\n\\ndef _resolve(host, port):\\n    if _is_ipv4(host):\\n        return [(socket.AF_INET, socket.SOCK_STREAM, (host, port))]\\n    key = (host, port)\\n    now = time.ticks_ms()\\n    e = _dns.get(key)\\n    if e and time.ticks_diff(now, e[0]) < 600000:\\n        return e[1]\\n    infos = []\\n    for fam, typ, _proto, _canon, addr in socket.getaddrinfo(\\n            host, port, 0, socket.SOCK_STREAM):\\n        if fam == socket.AF_INET:\\n            infos.insert(0, (fam, typ, addr))\\n        else:\\n            infos.append((fam, typ, addr))\\n    if len(_dns) > 6:\\n        _dns.clear()\\n    _dns[key] = (now, infos)\\n    return infos\\n\\n\\ndef http_get(host, path, port, timeout, max_size):\\n    last = None\\n    for fam, typ, addr in _resolve(host, port):\\n        s = None\\n        try:\\n            s = socket.socket(fam, typ)\\n            s.settimeout(timeout)\\n            s.connect(addr)\\n            req = (\\\"GET \\\" + path + \\\" HTTP/1.0\\\\r\\\\nHost: \\\" + host +\\n                   \\\"\\\\r\\\\nConnection: close\\\\r\\\\nUser-Agent: AtomS3-Desk\\\\r\\\\n\\\\r\\\\n\\\")\\n            s.send(req.encode())\\n            parts = []\\n            total = 0\\n            while total < max_size:\\n                d = s.recv(512)\\n                if not d:\\n                    break\\n                parts.append(d)\\n                total += len(d)\\n            return b\\\"\\\".join(parts)\\n        except Exception as e:\\n            last = e\\n        finally:\\n            if s is not None:\\n                try:\\n                    s.close()\\n                except Exception:\\n                    pass\\n    if last is not None:\\n        raise last\\n    return b\\\"\\\"\\n\\n\\ndef _body(raw):\\n    i = raw.find(b\\\"\\\\r\\\\n\\\\r\\\\n\\\")\\n    return raw[i + 4:] if i >= 0 else b\\\"\\\"\\n\\n\\ndef _status(raw):\\n    try:\\n        return int(raw.split(b\\\"\\\\r\\\\n\\\", 1)[0].split(b\\\" \\\")[1])\\n    except Exception:\\n        return 0\\n\\n\\ndef _parse_url(u):\\n    if not u:\\n        return None\\n    u = u.strip()\\n    port = 8765\\n    if u.startswith(\\\"http://\\\"):\\n        u = u[7:]\\n    elif u.startswith(\\\"https://\\\"):\\n        u = u[8:]\\n    if \\\"/\\\" in u:\\n        u = u.split(\\\"/\\\", 1)[0]\\n    if \\\":\\\" in u:\\n        u, ps = u.split(\\\":\\\", 1)\\n        try:\\n            port = int(ps)\\n        except Exception:\\n            pass\\n    return (u, port) if u else None\\n\\n\\nclass Hub:\\n    def __init__(self, wlan, cfg):\\n        self.wlan = wlan\\n        h = cfg.get(\\\"hub\\\") or {}\\n        self.token = (h.get(\\\"token\\\") or \\\"\\\").strip()\\n        urls = h.get(\\\"urls\\\") or []\\n        if not urls:\\n            urls = [h.get(\\\"url\\\") or \\\"\\\"]\\n        self.targets = []\\n        for u in urls:\\n            t = _parse_url(u)\\n            if t:\\n                self.targets.append(t)\\n        self.host, self.port = (self.targets[0] if self.targets\\n                                else (\\\"\\\", 8765))\\n        self.bad = {}\\n        self.rev = {}\\n        self.ui = None\\n        self.sp = {}\\n        self.ly = {}\\n        self.ev = {}\\n        self.ts = 0\\n        self.clock_diff = 0\\n        self.ok_at = time.ticks_ms() - 1000000\\n        self.at = time.ticks_ms() - 1000000\\n        self.err = \\\"\\\"\\n        self.new_events = []\\n        self.last_event = 0\\n        self.sp_pos = 0\\n        self.sp_at = time.ticks_ms()\\n        self.sp_hist = []\\n        self.sp_stalled = False\\n        self.sp_key = None\\n        self.sp_playing = False\\n\\n    def age(self):\\n        return time.ticks_diff(time.ticks_ms(), self.ok_at) // 1000\\n\\n    def fresh(self, ms=6000):\\n        return time.ticks_diff(time.ticks_ms(), self.ok_at) <= ms\\n\\n    def now(self):\\n        return int(time.time()) + self.clock_diff\\n\\n    def progress(self):\\n        pos = self.sp_pos\\n        if self.playing():\\n            pos += time.ticks_diff(time.ticks_ms(), self.sp_at)\\n        dur = int(self.sp.get(\\\"duration_ms\\\") or 0)\\n        if pos < 0:\\n            pos = 0\\n        if dur and pos > dur:\\n            pos = dur\\n        return pos\\n\\n    def playing(self):\\n        \\\"\\\"\\\"Spotify is really playing, not just a stale is_playing flag.\\\"\\\"\\\"\\n        return bool(self.sp.get(\\\"is_playing\\\")) and not self.sp_stalled\\n\\n    def _watch_sp(self):\\n        \\\"\\\"\\\"Catch a frozen position even if the hub still says playing.\\n\\n        The hub normally filters this, but an older hub build (or a stalled\\n        state refresh) can leave is_playing=True.  Anchors arrive every few\\n        seconds; a real track advances by roughly the elapsed time, while a\\n        paused one only jitters by a second or so.\\n        \\\"\\\"\\\"\\n        now = time.ticks_ms()\\n        sp = self.sp\\n        playing = bool(sp.get(\\\"is_playing\\\"))\\n        key = (sp.get(\\\"song\\\"), sp.get(\\\"artist\\\"),\\n               int(sp.get(\\\"duration_ms\\\") or 0))\\n        if playing and not self.sp_playing:\\n            # Playback just started: trust the hub and start a fresh window\\n            # instead of staying stuck on an old stall.\\n            self.sp_hist = []\\n            self.sp_stalled = False\\n        self.sp_playing = playing\\n        if not playing or self.sp_key != key:\\n            self.sp_key = key\\n            self.sp_hist = []\\n            self.sp_stalled = False\\n            if not playing:\\n                return\\n        self.sp_hist.append((now, self.sp_pos))\\n        while self.sp_hist and (\\n                len(self.sp_hist) > 6 or\\n                time.ticks_diff(now, self.sp_hist[0][0]) > 12000):\\n            self.sp_hist.pop(0)\\n        if len(self.sp_hist) < 2:\\n            return\\n        if self.sp_stalled:\\n            # Fast resume: a position that clearly advances over the last\\n            # couple of samples means playback restarted, even while old\\n            # frozen samples are still inside the window.\\n            t1, p1 = self.sp_hist[-1]\\n            for t, p in reversed(self.sp_hist[:-1]):\\n                d2 = time.ticks_diff(t1, t)\\n                if d2 >= 1500:\\n                    if p1 - p >= d2 * 0.6:\\n                        self.sp_stalled = False\\n                    break\\n            if not self.sp_stalled:\\n                return\\n        t0, p0 = self.sp_hist[0]\\n        dt = time.ticks_diff(now, t0)\\n        if dt < 6000:\\n            return\\n        advance = self.sp_pos - p0\\n        if advance < -2000:\\n            # A seek or track jump is not a stall.\\n            self.sp_hist = [(now, self.sp_pos)]\\n            self.sp_stalled = False\\n            return\\n        self.sp_stalled = advance < dt * 0.4\\n\\n    def _ok_target(self, host):\\n        \\\"\\\"\\\"A private hub address is only useful on its own subnet.\\\"\\\"\\\"\\n        try:\\n            parts = [int(x) for x in host.split(\\\".\\\")]\\n        except Exception:\\n            return True\\n        if len(parts) != 4:\\n            return True\\n        a, b = parts[0], parts[1]\\n        if a == 127:\\n            return False\\n        if not (a == 10 or (a == 192 and b == 168) or\\n                (a == 172 and 16 <= b <= 31)):\\n            return True\\n        try:\\n            ip, mask = self.wlan.ifconfig()[:2]\\n            ip = [int(x) for x in ip.split(\\\".\\\")]\\n            mask = [int(x) for x in mask.split(\\\".\\\")]\\n            for i in range(4):\\n                if (parts[i] & mask[i]) != (ip[i] & mask[i]):\\n                    return False\\n            return True\\n        except Exception:\\n            return True\\n\\n    def _cands(self, now):\\n        out = []\\n        if self.host:\\n            out.append((self.host, self.port))\\n        for t in self.targets:\\n            if t not in out:\\n                out.append(t)\\n        good = []\\n        for host, port in out:\\n            if not self._ok_target(host):\\n                continue\\n            if time.ticks_diff(self.bad.get((host, port), 0), now) > 0:\\n                continue\\n            good.append((host, port))\\n        good.sort(key=lambda t: 0 if _is_ipv4(t[0]) else 1)\\n        return good\\n\\n    def get(self, path, timeout=HUB_TIMEOUT_S, max_size=8192):\\n        now = time.ticks_ms()\\n        for host, port in self._cands(now):\\n            try:\\n                if self.token:\\n                    path2 = path + (\\\"&\\\" if \\\"?\\\" in path else \\\"?\\\") + \\\\\\n                        \\\"k=\\\" + self.token\\n                else:\\n                    path2 = path\\n                raw = http_get(host, path2, port, timeout, max_size)\\n                if _status(raw) == 401:\\n                    self.err = \\\"BAD TOKEN\\\"\\n                    continue\\n                body = _body(raw)\\n                if not body:\\n                    self.err = \\\"EMPTY\\\"\\n                    continue\\n                d = json.loads(body)\\n                self.host, self.port = host, port\\n                self.bad.pop((host, port), None)\\n                self.err = \\\"\\\"\\n                return d\\n            except Exception as e:\\n                msg = str(e)\\n                if \\\"116\\\" in msg or \\\"110\\\" in msg:\\n                    self.err = \\\"HUB TIMEOUT\\\"\\n                elif \\\"111\\\" in msg or \\\"104\\\" in msg or \\\"113\\\" in msg:\\n                    self.err = \\\"HUB OFFLINE\\\"\\n                else:\\n                    self.err = msg[:22]\\n                self.bad[(host, port)] = time.ticks_add(now, HUB_BAD_MS)\\n        if not self.err:\\n            self.err = \\\"HUB OFFLINE\\\"\\n        return None\\n\\n    def poll(self, now, interval_ms):\\n        if time.ticks_diff(now, self.at) < 0:\\n            return False\\n        self.at = time.ticks_add(now, interval_ms)\\n        path = \\\"/state?only=ui,sp,ly,ev\\\"\\n        for k, v in self.rev.items():\\n            path += \\\"&r_\\\" + k + \\\"=\\\" + str(v)\\n        d = self.get(path, timeout=HUB_TIMEOUT_S, max_size=12288)\\n        if not d:\\n            return False\\n        self.apply(d)\\n        return True\\n\\n    def apply(self, j):\\n        ts = int(j.get(\\\"ts\\\") or 0)\\n        if ts:\\n            self.ts = ts\\n            diff = ts - int(time.time())\\n            if abs(diff) > 1:\\n                self.clock_diff = diff\\n        for k, v in (j.get(\\\"rev\\\") or {}).items():\\n            self.rev[k] = v\\n        if \\\"ui\\\" in j:\\n            self.ui = j[\\\"ui\\\"]\\n        if \\\"sp\\\" in j:\\n            self.sp = j[\\\"sp\\\"] or {}\\n            self.sp_pos = int(self.sp.get(\\\"progress_ms\\\") or 0)\\n            self.sp_at = time.ticks_ms()\\n            self._watch_sp()\\n        if \\\"ly\\\" in j:\\n            self.ly = j[\\\"ly\\\"] or {}\\n        if \\\"ev\\\" in j:\\n            self._events(j[\\\"ev\\\"] or {})\\n        self.ok_at = time.ticks_ms()\\n\\n    def _events(self, ev):\\n        try:\\n            last = int(ev.get(\\\"last\\\") or 0)\\n        except Exception:\\n            last = 0\\n        if last < self.last_event:\\n            self.last_event = 0\\n        for e in ev.get(\\\"events\\\") or []:\\n            try:\\n                eid = int(e.get(\\\"id\\\") or 0)\\n            except Exception:\\n                eid = 0\\n            if eid > self.last_event:\\n                self.last_event = eid\\n                self.new_events.append(e)\\n        if len(self.new_events) > 6:\\n            del self.new_events[:-6]\\n\")\n_w(\"desk/loop.py\", \"\\\"\\\"\\\"Main loop: polling, input gestures, notifications and drawing.\\\"\\\"\\\"\\nimport M5\\nimport gc\\nimport math\\nimport time\\nfrom desk.const import CLICK_GAP_MS, HOLD_MS, HUB_POLL_LIVE_MS, HUB_POLL_MS, NOTIF_MAX_AGE_S, NOTIF_SHOW_MS, NTP_FALLBACK_MS, ROWS_PAGE_MS, SOFT_HOLD_MS, STATUS_PAGE_MS\\nfrom desk.ui import AMBER, GREEN, RED, splash, splash_line\\n\\n\\ndef _is_down(btn):\\n    \\\"\\\"\\\"MicroPython builds differ in the button API; try each spelling.\\\"\\\"\\\"\\n    for name in (\\\"isPressed\\\", \\\"is_pressed\\\", \\\"pressed\\\"):\\n        fn = getattr(btn, name, None)\\n        if fn is None:\\n            continue\\n        try:\\n            return bool(fn())\\n        except Exception:\\n            continue\\n    try:\\n        return bool(btn.value())\\n    except Exception:\\n        return False\\n\\n\\nclass AppLoop:\\n    # -- spotify / restart actions -----------------------------------\\n    def spotify(self, path):\\n        self.hub.get(path, timeout=2.0, max_size=2048)\\n        self.hub.at = time.ticks_add(time.ticks_ms(), -1000)\\n\\n    def restart_spotify(self):\\n        now = time.ticks_ms()\\n        d = self.hub.get(\\\"/spotify_restart\\\", timeout=2.0, max_size=2048)\\n        r = self.rst\\n        if d and d.get(\\\"status\\\") in (\\\"queued\\\", \\\"success\\\", \\\"triggered\\\"):\\n            r[\\\"state\\\"] = \\\"busy\\\"\\n            r[\\\"msg\\\"] = (d.get(\\\"message\\\") or \\\"restarting\\\")[:20]\\n            r[\\\"sent\\\"] = now\\n        else:\\n            r[\\\"state\\\"] = \\\"error\\\"\\n            r[\\\"msg\\\"] = (self.hub.err or \\\"HUB OFFLINE\\\")[:18]\\n            r[\\\"sent\\\"] = now\\n        r[\\\"at\\\"] = time.ticks_add(now, -5000)\\n        r[\\\"check_at\\\"] = 0\\n        r[\\\"checks\\\"] = 0\\n        r[\\\"good\\\"] = 0\\n        r[\\\"prog\\\"] = -1\\n        r[\\\"song\\\"] = \\\"\\\"\\n        self.draw_restart(self.page())\\n\\n    def restart_check(self, now):\\n        \\\"\\\"\\\"Prove playback really resumed after the restart.\\n\\n        Polls the hub directly about once a second for six seconds and counts\\n        samples where the same song is playing and the position has moved, so a\\n        stale payload copied over from before the restart cannot pass.\\n        \\\"\\\"\\\"\\n        r = self.rst\\n        if time.ticks_diff(now, r[\\\"at\\\"]) < 900:\\n            return False\\n        r[\\\"at\\\"] = now\\n        r[\\\"dots\\\"] = (r[\\\"dots\\\"] + 1) % 4\\n        d = self.hub.get(\\\"/state?only=sp\\\", timeout=2.0, max_size=2048)\\n        if d:\\n            self.hub.apply(d)\\n            sp = self.hub.sp or {}\\n            ok = (sp.get(\\\"status\\\") == \\\"success\\\" and sp.get(\\\"is_playing\\\")\\n                  and sp.get(\\\"song\\\"))\\n            p = int(sp.get(\\\"progress_ms\\\") or 0)\\n            song = sp.get(\\\"song\\\") or \\\"\\\"\\n            if ok and r[\\\"prog\\\"] >= 0 and p != r[\\\"prog\\\"] and song == r[\\\"song\\\"]:\\n                r[\\\"good\\\"] += 1\\n            r[\\\"prog\\\"] = p if ok else -1\\n            r[\\\"song\\\"] = song\\n        if time.ticks_diff(now, r[\\\"check_at\\\"]) >= 6000:\\n            r[\\\"state\\\"] = \\\"done\\\" if r[\\\"good\\\"] >= 2 else \\\"notsynced\\\"\\n        return True\\n\\n    def action(self):\\n        p = self.page()\\n        k = p.get(\\\"k\\\")\\n        if k == \\\"focus\\\":\\n            self.pom.toggle()\\n            self.focus_at = 0\\n            self.dirty = True\\n        elif k == \\\"restart\\\":\\n            self.restart_spotify()\\n        elif k in (\\\"clock\\\", \\\"big\\\", \\\"rows\\\", \\\"notice\\\", \\\"status\\\", \\\"sys\\\"):\\n            self.hub.at = 0\\n            self.clk_sec = -1\\n            self.status_at = 0\\n            self.dirty = True\\n\\n    # -- auto-advancing rows -----------------------------------------\\n    def rows_tick(self, now, npages):\\n        \\\"\\\"\\\"Advance the rows sub-page.  True when the page needs a redraw.\\\"\\\"\\\"\\n        if npages < 2:\\n            return False\\n        if time.ticks_diff(now, self.rs_at) < ROWS_PAGE_MS:\\n            return False\\n        self.rs_at = now\\n        self.rs_page = (self.rs_page + 1) % npages\\n        return True\\n\\n    # -- buttons -----------------------------------------------------\\n    def buttons(self, now):\\n        b = getattr(M5, \\\"BtnA\\\", None)\\n        if b is None:\\n            return\\n        down = _is_down(b)\\n        if down:\\n            if not self.down:\\n                self.down = True\\n                self.press_at = now\\n                self.hold_done = False\\n                self.soft_done = False\\n            elif not self.hold_done:\\n                held = time.ticks_diff(now, self.press_at)\\n                if (not self.soft_done and self.banner is None and\\n                        held >= SOFT_HOLD_MS):\\n                    if self.mode == 1 and self.page().get(\\\"k\\\") == \\\"spotify\\\":\\n                        self.spot.soft_hold()\\n                        self.soft_done = True\\n                if held >= HOLD_MS:\\n                    self.switch_mode()\\n        elif self.down:\\n            self.down = False\\n            if not self.hold_done and not self.soft_done:\\n                self.clicks.append(now)\\n        if self.clicks and time.ticks_diff(now, self.clicks[-1]) > CLICK_GAP_MS:\\n            n = len(self.clicks)\\n            self.clicks = []\\n            self.gesture(n)\\n\\n    def gesture(self, n):\\n        if self.banner is not None:\\n            self.banner = None\\n            self.banner_dirty = False\\n            self.enter_page()\\n            return\\n        if self.mode == 1:\\n            if n == 1:\\n                self.spotify(\\\"/spotify_toggle\\\")\\n            elif n == 2:\\n                self.spotify(\\\"/spotify_next\\\")\\n            else:\\n                self.spotify(\\\"/spotify_previous\\\")\\n        elif n == 1:\\n            self.next_page()\\n        else:\\n            self.action()\\n\\n    # -- notifications ----------------------------------------------\\n    def tick_notify(self, now):\\n        if self.hub.new_events:\\n            for e in self.hub.new_events:\\n                ts = int(e.get(\\\"ts\\\") or 0)\\n                if not ts or self.now() - ts <= NOTIF_MAX_AGE_S:\\n                    self.banners.append(e)\\n            self.hub.new_events = []\\n            if len(self.banners) > 6:\\n                del self.banners[:-6]\\n        if self.banner is not None:\\n            if time.ticks_diff(now, self.banner_at) > NOTIF_SHOW_MS:\\n                self.banner = None\\n                self.enter_page()\\n        if self.banner is None and self.banners:\\n            self.banner = self.banners.pop(0)\\n            self.banner_at = now\\n            self.banner_dirty = True\\n\\n    # -- main loop ---------------------------------------------------\\n    def run(self):\\n        M5.Display.setBrightness(self.bright)\\n        splash()\\n        self.started = time.ticks_ms()\\n        boot_at = self.started\\n        booting = True\\n        while True:\\n            now = time.ticks_ms()\\n            M5.update()\\n\\n            up = self.wifi.poll(now, self.hub.fresh(30000))\\n            if up and not self.connected_at:\\n                self.connected_at = now\\n                self.dirty = True\\n            if booting:\\n                # Keep the splash up while joining, but never block.  A long\\n                # stall here trips the task watchdog and the board resets in a\\n                # loop instead of ever reaching the first page.\\n                if up:\\n                    try:\\n                        ip = self.wifi.wlan.ifconfig()[0]\\n                    except Exception:\\n                        ip = \\\"?\\\"\\n                    splash_line(\\\"%s %s\\\" % (\\n                        (self.wifi.ssid or \\\"WIFI\\\")[:13], ip), GREEN)\\n                    booting = False\\n                    self.dirty = True\\n                elif time.ticks_diff(now, boot_at) > 12000:\\n                    splash_line(\\\"NO WIFI - CHECK CONFIG\\\", RED)\\n                    booting = False\\n                    self.dirty = True\\n                else:\\n                    splash_line(\\\"JOIN %s\\\" % (self.wifi.try_ssid or\\n                                             self.wifi.err or \\\"...\\\"), AMBER)\\n                time.sleep_ms(60)\\n                continue\\n            if (up and not self.ntp_done and not self.hub.ts and\\n                    time.ticks_diff(now, self.connected_at) > NTP_FALLBACK_MS):\\n                # One-shot fallback for the first boot without any hub time.\\n                self.ntp_done = True\\n                try:\\n                    import ntptime\\n                    try:\\n                        ntptime.settime(\\\"216.239.35.0\\\")\\n                    except TypeError:\\n                        ntptime.settime()\\n                except Exception:\\n                    pass\\n\\n            p = self.page()\\n            kind = p.get(\\\"k\\\") or \\\"\\\"\\n            if kind in (\\\"spotify\\\", \\\"rows\\\"):\\n                interval = HUB_POLL_LIVE_MS\\n            elif kind == \\\"status\\\":\\n                interval = HUB_POLL_LIVE_MS\\n            else:\\n                interval = HUB_POLL_MS\\n            if kind == \\\"spotify\\\" and self.spot.lyrics:\\n                interval = 400\\n            if up:\\n                self.hub.poll(now, interval)\\n            if self.hub.ui is not self.last_ui:\\n                self.last_ui = self.hub.ui\\n                self.ui = self.hub.ui\\n                n = len(self.page_list())\\n                if self.idx >= n:\\n                    self.idx = 0\\n                self.dirty = True\\n\\n            self.pom.update(now)\\n            level = self.light.tick(now)\\n            if level is not None:\\n                self.bright = level\\n                self.led.set_bright(level)\\n            self.bright = self.light.value\\n\\n            try:\\n                self.buttons(now)\\n            except Exception as e:\\n                print(\\\"btn\\\", e)\\n            self.tick_notify(now)\\n\\n            p = self.page()\\n            kind = p.get(\\\"k\\\") or \\\"\\\"\\n            if self.banner is not None:\\n                if self.banner_dirty:\\n                    self.banner_dirty = False\\n                    try:\\n                        self.draw_banner()\\n                    except Exception as e:\\n                        print(\\\"banner\\\", e)\\n            elif kind == \\\"clock\\\":\\n                s = self.local()[5]\\n                if s != self.clk_sec:\\n                    try:\\n                        self.draw_clock(p)\\n                    except Exception as e:\\n                        print(\\\"draw\\\", e)\\n            elif kind == \\\"focus\\\":\\n                if time.ticks_diff(now, self.focus_at) >= 250:\\n                    try:\\n                        self.draw_focus(p)\\n                    except Exception as e:\\n                        print(\\\"draw\\\", e)\\n            elif kind == \\\"face\\\":\\n                if time.ticks_diff(now, self.face_at) >= 100:\\n                    self.face_at = now\\n                    f = self.face\\n                    f[\\\"breath\\\"] = (f[\\\"breath\\\"] + 1) % 30\\n                    f[\\\"dev\\\"] = int(4 * math.sin(\\n                        f[\\\"breath\\\"] * 2 * math.pi / 30))\\n                    f[\\\"tm\\\"] += 100\\n                    if f[\\\"st\\\"] == 0:\\n                        if f[\\\"tm\\\"] >= 3000:\\n                            f[\\\"st\\\"] = 1\\n                            f[\\\"tm\\\"] = 0\\n                            f[\\\"open\\\"] = 2000 + (f[\\\"breath\\\"] % 5) * 1000\\n                    elif f[\\\"tm\\\"] >= f[\\\"open\\\"]:\\n                        f[\\\"st\\\"] = 0\\n                        f[\\\"tm\\\"] = 0\\n                    try:\\n                        self.draw_face(p)\\n                    except Exception as e:\\n                        print(\\\"draw\\\", e)\\n            elif kind == \\\"status\\\":\\n                if time.ticks_diff(now, self.st_at) >= STATUS_PAGE_MS:\\n                    self.st_page = 1 - self.st_page\\n                    self.st_at = now\\n                    self.status_at = 0\\n                if time.ticks_diff(now, self.status_at) >= 1000:\\n                    try:\\n                        self.draw_status(p)\\n                    except Exception as e:\\n                        print(\\\"draw\\\", e)\\n            elif kind == \\\"sys\\\":\\n                if time.ticks_diff(now, self.status_at) >= 1000:\\n                    try:\\n                        self.draw_sys(p)\\n                    except Exception as e:\\n                        print(\\\"draw\\\", e)\\n            elif kind == \\\"spotify\\\":\\n                try:\\n                    if self.dirty:\\n                        self.dirty = False\\n                        self.spot.dirty_full = True\\n                    self.spot.tick(now)\\n                    self.spot.draw()\\n                except Exception as e:\\n                    print(\\\"spot\\\", e)\\n            elif kind == \\\"restart\\\":\\n                r = self.rst\\n                if r[\\\"state\\\"] == \\\"busy\\\":\\n                    if time.ticks_diff(now, r[\\\"sent\\\"]) > 10000:\\n                        r[\\\"state\\\"] = \\\"check\\\"\\n                        r[\\\"check_at\\\"] = now\\n                        r[\\\"at\\\"] = time.ticks_add(now, -1000)\\n                        r[\\\"good\\\"] = 0\\n                        r[\\\"prog\\\"] = -1\\n                        r[\\\"song\\\"] = \\\"\\\"\\n                        self.dirty = True\\n                    elif time.ticks_diff(now, r[\\\"at\\\"]) > 400:\\n                        r[\\\"at\\\"] = now\\n                        r[\\\"dots\\\"] = (r[\\\"dots\\\"] + 1) % 4\\n                        self.dirty = True\\n                elif r[\\\"state\\\"] == \\\"check\\\":\\n                    if self.restart_check(now):\\n                        self.dirty = True\\n                elif (r[\\\"state\\\"] == \\\"error\\\" and\\n                      time.ticks_diff(now, r[\\\"sent\\\"]) > 5000):\\n                    r[\\\"state\\\"] = \\\"idle\\\"\\n                    self.dirty = True\\n                if self.dirty:\\n                    try:\\n                        self.draw_restart(p)\\n                    except Exception as e:\\n                        print(\\\"draw\\\", e)\\n                    self.dirty = False\\n            elif kind == \\\"rows\\\":\\n                if self.rows_tick(now, self.rows_pages(p)):\\n                    self.dirty = True\\n                if self.dirty:\\n                    try:\\n                        self.draw_rows(p)\\n                    except Exception as e:\\n                        print(\\\"draw\\\", e)\\n                    self.dirty = False\\n            else:\\n                if self.dirty:\\n                    try:\\n                        self.draw(p)\\n                    except Exception as e:\\n                        print(\\\"draw\\\", e)\\n                    self.dirty = False\\n\\n            self.led.update(now, self.alert())\\n            if self.banner is not None and not self.alert():\\n                self.led.flash((now // 250) % 2 == 0)\\n\\n            if (time.ticks_diff(now, self.started) > 60000 and\\n                    gc.mem_free() < 30000):\\n                gc.collect()\\n            time.sleep_ms(5 if self.spot.animating else 20)\\n\")\n_w(\"desk/pom.py\", \"\\\"\\\"\\\"Local pomodoro timer, ambient-light brightness and the alert LED.\\\"\\\"\\\"\\nimport time\\nfrom desk.ui import LCD\\n\\n# ------------------------------------------------------------------ pomodoro\\nclass Pomodoro:\\n    def __init__(self, cfg):\\n        p = cfg.get(\\\"pomodoro\\\") or {}\\n        self.focus = int(p.get(\\\"focus\\\", 25)) * 60000\\n        self.brk = int(p.get(\\\"break\\\", 5)) * 60000\\n        self.mode = \\\"focus\\\"\\n        self.running = False\\n        self.rem = self.focus\\n        self.end = 0\\n        self.sessions = 1\\n\\n    def toggle(self):\\n        if self.running:\\n            self.rem = time.ticks_diff(self.end, time.ticks_ms())\\n            if self.rem < 0:\\n                self.rem = 0\\n            self.running = False\\n        else:\\n            self.end = time.ticks_add(time.ticks_ms(), self.rem)\\n            self.running = True\\n\\n    def update(self, now):\\n        if not self.running:\\n            return False\\n        rem = time.ticks_diff(self.end, now)\\n        if rem <= 0:\\n            if self.mode == \\\"focus\\\":\\n                self.mode = \\\"break\\\"\\n                self.rem = self.brk\\n            else:\\n                self.mode = \\\"focus\\\"\\n                self.sessions += 1\\n                self.rem = self.focus\\n            self.end = time.ticks_add(now, self.rem)\\n            return True\\n        self.rem = rem\\n        return False\\n\\n\\n# ------------------------------------------------------------- brightness\\nclass Light:\\n    def __init__(self, cfg):\\n        d = cfg.get(\\\"display\\\") or {}\\n        self.on = bool(d.get(\\\"auto\\\", True))\\n        self.min = int(d.get(\\\"min\\\", 10))\\n        self.max = int(d.get(\\\"max\\\", d.get(\\\"brightness\\\", 120)))\\n        if self.min < 1:\\n            self.min = 1\\n        if self.max < self.min:\\n            self.max = self.min\\n        self.interval = int(d.get(\\\"interval\\\", 2000))\\n        self.pct = 100\\n        self.avg = None\\n        self.value = int(d.get(\\\"brightness\\\", self.max))\\n        if self.value < self.min:\\n            self.value = self.min\\n        elif self.value > self.max:\\n            self.value = self.max\\n        self.at = 0\\n        self.adc = None\\n        if self.on:\\n            try:\\n                from machine import ADC, Pin\\n                pin = int(d.get(\\\"light_pin\\\", 6))\\n                try:\\n                    self.adc = ADC(Pin(pin), atten=ADC.ATTN_11DB)\\n                except TypeError:\\n                    self.adc = ADC(Pin(pin))\\n                    try:\\n                        self.adc.atten(ADC.ATTN_11DB)\\n                    except Exception:\\n                        pass\\n            except Exception:\\n                self.adc = None\\n        if self.adc is None:\\n            self.on = False\\n\\n    def tick(self, now):\\n        if not self.on or self.adc is None:\\n            return None\\n        if time.ticks_diff(now, self.at) < self.interval:\\n            return None\\n        self.at = now\\n        try:\\n            a = self.adc.read()\\n            b = self.adc.read()\\n            c = self.adc.read()\\n        except Exception:\\n            return None\\n        raw = sorted((a, b, c))[1]   # median ignores single-sample spikes\\n        if self.avg is None:\\n            self.avg = raw\\n        else:\\n            self.avg = (self.avg * 3 + raw) // 4\\n        self.pct = max(0, min(100, self.avg * 100 // 4095))\\n        adj = min(100, int(self.pct ** 0.5 * 10))\\n        target = self.min + (self.max - self.min) * adj // 100\\n        # Slew-limit plus a deadband: a noisy sensor or light that shines on\\n        # the panel must not make the backlight pulse between bright and off.\\n        if target > self.value + 18:\\n            target = self.value + 18\\n        elif target < self.value - 18:\\n            target = self.value - 18\\n        if abs(target - self.value) < 6:\\n            return None\\n        self.value = target\\n        return target\\n\\n\\nclass Led:\\n    \\\"\\\"\\\"Critical-service LED.  The screen backlight can pulse as a fallback.\\\"\\\"\\\"\\n\\n    PERIOD = 900\\n\\n    def __init__(self, bright, cfg):\\n        a = cfg.get(\\\"alerts\\\") or {}\\n        self.bright = bright\\n        self.dim_level = max(2, bright // 6)\\n        self.backlight = bool(a.get(\\\"backlight\\\", False))\\n        self.at = 0\\n        self.dim = False\\n        self.led = None\\n        try:\\n            from machine import Pin\\n            gpio = int(a.get(\\\"led_gpio\\\", 5))\\n            if gpio:\\n                self.led = Pin(gpio, Pin.OUT)\\n                self.led.value(0)\\n        except Exception:\\n            self.led = None\\n\\n    def _lcd(self, v):\\n        try:\\n            LCD.setBrightness(v)\\n        except Exception:\\n            pass\\n\\n    def _pin(self, on):\\n        if self.led is None:\\n            return\\n        try:\\n            self.led.value(1 if on else 0)\\n        except Exception:\\n            self.led = None\\n\\n    def set_bright(self, v):\\n        self.bright = v\\n        self.dim_level = max(2, v // 6)\\n        if not self.dim:\\n            self._lcd(v)\\n\\n    def flash(self, on):\\n        self._pin(on)\\n\\n    def update(self, now, active):\\n        if not active:\\n            if self.dim:\\n                self.dim = False\\n                if self.backlight:\\n                    self._lcd(self.bright)\\n            self._pin(False)\\n            return\\n        if time.ticks_diff(now, self.at) < self.PERIOD:\\n            return\\n        self.at = now\\n        self.dim = not self.dim\\n        self._pin(self.dim)\\n        if self.backlight:\\n            self._lcd(self.dim_level if self.dim else self.bright)\\n\")\n_w(\"desk/spot.py\", \"\\\"\\\"\\\"Spotify page state machine: horizontal scroll, lyric slide-up and timing.\\n\\nLyrics behave like a small teleprompter.  The line being sung is on top and the\\ncoming lines are below; a line that is wider than the panel continues on the\\nnext row instead of scrolling sideways or changing font size, and when the line\\nchanges the block slides up by however many rows the finished line used.  Every\\nrow uses the same mid-size font and pitch.  A line that needs more than four\\nrows is paged through over time so no row is cut off.\\n\\\"\\\"\\\"\\nimport time\\n\\nfrom desk.ui import F_JA, F_TINY, LCD, W, tw\\nfrom desk.spotdraw import SpotDraw\\n\\n\\ndef _atoms(s):\\n    \\\"\\\"\\\"Split a line into units that a row break may fall between.\\n\\n    Latin words stay whole so they are never cut mid-word; CJK characters\\n    each stand alone, which is where Japanese lyrics naturally break.\\n    \\\"\\\"\\\"\\n    out = []\\n    word = \\\"\\\"\\n    for ch in s:\\n        if ch == \\\" \\\":\\n            if word:\\n                out.append(word)\\n                word = \\\"\\\"\\n            out.append(\\\" \\\")\\n        elif ord(ch) > 0x2FF:\\n            if word:\\n                out.append(word)\\n                word = \\\"\\\"\\n            out.append(ch)\\n        else:\\n            word += ch\\n    if word:\\n        out.append(word)\\n    return out\\n\\n\\nclass Spot(SpotDraw):\\n    def __init__(self, app):\\n        self.app = app\\n        self.pos = 0\\n        self.dir = 1\\n        self.hold_until = 0\\n        self.max_off = 0\\n        self.long = False\\n        self.step = 1\\n        self.frame_at = 0\\n        self.prog_at = 0\\n        self.dirty_full = True\\n        self.dirty_lines = False\\n        self.dirty_prog = False\\n        self.animating = False\\n        self.lyrics = False\\n        self.sig = None\\n        self.lyr_key = None\\n        self.buf = (\\\"\\\", \\\"\\\", \\\"\\\")     # current line, next line, next-next line\\n        self.line = \\\"\\\"\\n        self.w_cur = ()             # wrapped rows of each buffered line\\n        self.w_next = ()\\n        self.w_n2 = ()\\n        self.disp = ()              # the rows on screen, top to bottom\\n        self.cur_rows = 1           # rows of the sung line on this page\\n        self.line_rows = 0          # total rows of the sung line\\n        self.line_pages = 1         # pages needed for the sung line\\n        self.line_page = 0          # page currently drawn\\n        self.page_line = \\\"\\\"         # line the page index belongs to\\n        self.page_ms = self.PAGE_MS\\n        self.page_at = 0\\n        self.txt = self.TXT         # fixed lyric scale (every row matches)\\n        self.slot_h = self.SLOT_H   # matching row pitch\\n        self.slide = 0              # px the lyric block has slid up\\n        self.slide_px = self.SLOT_H\\n        self.slide_at = 0\\n        self.armed_for = None       # next_at value already animated for\\n        self.sync_at = 0            # next direct lyric alignment with Spotify\\n\\n    def enter(self):\\n        self.sig = None\\n        self.pos = 0\\n        self.dir = 1\\n        self.dirty_full = True\\n        self.frame_at = time.ticks_ms()\\n        self.hold_until = time.ticks_add(time.ticks_ms(), self.HOLD_MS)\\n        self.lyr_key = None\\n        self.buf = (\\\"\\\", \\\"\\\", \\\"\\\")\\n        self.line = \\\"\\\"\\n        self.line_page = 0\\n        self.page_line = \\\"\\\"\\n        self.page_at = time.ticks_ms()\\n        self._build_disp()\\n        self.slide = 0\\n        self.armed_for = None\\n        # Align with the live Spotify position shortly after entering (and\\n        # every few seconds after that) instead of trusting the first payload.\\n        self.sync_at = time.ticks_add(time.ticks_ms(), 2000)\\n\\n    def soft_hold(self):\\n        self.lyrics = not self.lyrics\\n        self.lyr_key = None\\n        self.buf = (\\\"\\\", \\\"\\\", \\\"\\\")\\n        self.line = \\\"\\\"\\n        self.line_page = 0\\n        self.page_line = \\\"\\\"\\n        self.page_at = time.ticks_ms()\\n        self._build_disp()\\n        self.slide = 0\\n        self.armed_for = None\\n        self.long = False\\n        self.pos = 0\\n        self.dir = 1\\n        self.dirty_full = True\\n        if not self.lyrics:\\n            # Back to the song rows: re-measure them for sideways scrolling.\\n            self._plan(self.app.hub.sp or {})\\n\\n    def _pos(self):\\n        return self.app.hub.progress()\\n\\n    def refresh(self, now):\\n        hub = self.app.hub\\n        sp = hub.sp\\n        fresh = hub.fresh(10000)\\n        if not sp or not fresh:\\n            if not self.app.wifi.up():\\n                self._fail(\\\"NO WIFI\\\")\\n            else:\\n                self._fail(hub.err if hub.err else \\\"HUB OFFLINE\\\")\\n            return self.dirty_full\\n        st = sp.get(\\\"status\\\")\\n        if st not in (\\\"success\\\", \\\"not_playing\\\", \\\"paused\\\"):\\n            self._fail(sp.get(\\\"message\\\") or st or \\\"ERROR\\\")\\n            return self.dirty_full\\n        sig = (sp.get(\\\"song\\\"), sp.get(\\\"artist\\\"), sp.get(\\\"device\\\"),\\n               hub.playing())\\n        prev = self.sig\\n        self.sig = sig\\n        if sig != prev:\\n            self.pos = 0\\n            self.dir = 1\\n            self.frame_at = now\\n            self.hold_until = time.ticks_add(now, self.HOLD_MS)\\n            # a different track: drop the lyric block so it cuts, not slides\\n            self.lyr_key = None\\n            self.buf = (\\\"\\\", \\\"\\\", \\\"\\\")\\n            self.line = \\\"\\\"\\n            self.slide = 0\\n            self.armed_for = None\\n            self._plan(sp)\\n            self.dirty_full = True\\n        elif time.ticks_diff(now, self.prog_at) > 250:\\n            self.prog_at = now\\n            self.dirty_prog = True\\n        if self.lyrics:\\n            self._sync_lyrics(now)\\n        return (self.dirty_full or self.dirty_lines or self.dirty_prog)\\n\\n    def _fail(self, msg):\\n        msg = (msg or \\\"HUB OFFLINE\\\")[:22]\\n        if self.sig != msg or not self.buf[0]:\\n            self.sig = msg\\n            self.buf = (\\\"\\\", \\\"\\\", \\\"\\\")\\n            self.long = False\\n            self.animating = False\\n            self.slide = 0\\n            self.dirty_full = True\\n\\n    # -- lyrics ------------------------------------------------------\\n    def _sync_tick(self, now):\\n        \\\"\\\"\\\"Ask the hub for the line at our exact playback position.\\n\\n        The state feed only changes when a line changes and is built once a\\n        second, so it can lag a little.  Every few seconds we re-read the\\n        current line with our own interpolated position, which keeps the\\n        teleprompter aligned with what Spotify is actually singing.\\n        \\\"\\\"\\\"\\n        if self.slide:\\n            return\\n        if time.ticks_diff(now, self.sync_at) < 0:\\n            return\\n        self.sync_at = time.ticks_add(now, self.SYNC_MS)\\n        hub = self.app.hub\\n        if not hub.fresh(15000):\\n            return\\n        get = getattr(hub, \\\"get\\\", None)\\n        if get is None:\\n            return\\n        try:\\n            ly = get(\\\"/lyrics?pos=%d\\\" % int(self._pos()),\\n                     timeout=1.2, max_size=3072)\\n        except Exception:\\n            return\\n        if not isinstance(ly, dict) or not ly.get(\\\"status\\\"):\\n            return\\n        hub.ly = ly\\n        self._sync_lyrics(now, ly, force=True)\\n\\n    def _sync_lyrics(self, now, ly=None, force=False):\\n        if ly is None:\\n            ly = self.app.hub.ly\\n        if not ly:\\n            return\\n        st = ly.get(\\\"status\\\")\\n        if st != \\\"success\\\":\\n            key = (st, \\\"\\\")\\n            if key != self.lyr_key:\\n                self.lyr_key = key\\n                self.buf = (\\\"\\\", \\\"\\\", \\\"\\\")\\n                self.line = \\\"\\\"\\n                self.long = False\\n                self.slide = 0\\n                self.dirty_full = True\\n            return\\n        line = (ly.get(\\\"line\\\") or \\\"\\\").strip()\\n        new = (line, (ly.get(\\\"next\\\") or \\\"\\\").strip(),\\n               (ly.get(\\\"next2\\\") or \\\"\\\").strip())\\n        key = (\\\"success\\\", line)\\n        if key == self.lyr_key and not force:\\n            # Same sung line; still take a fresher lookahead so the row that\\n            # enters from below is already filled in.\\n            if (not self.slide and new[1] == self.buf[1]\\n                    and new[2] and new[2] != self.buf[2]):\\n                self.buf = (self.buf[0], self.buf[1], new[2])\\n                self._build_disp()\\n                self.dirty_lines = True\\n            return\\n        self.lyr_key = key\\n        cur = self.buf[0]\\n        if self.slide:\\n            # The animation is already running: the hub has caught up, so all\\n            # that can change is the line entering from below.\\n            if new[0] == self.buf[1]:\\n                self.buf = (self.buf[0], self.buf[1], new[2])\\n            return\\n        if new[0] == cur:\\n            # Same line, later payload (lookahead moved on).\\n            self.buf = new\\n            self._build_disp()\\n            self.dirty_lines = True\\n            return\\n        if new[0] == self.buf[1]:\\n            # The hub is one line ahead of what we show: slide now.\\n            self.buf = (self.buf[0], self.buf[1], new[2])\\n            self._start_slide(now)\\n            return\\n        # A jump (seek, or non-synced lyrics): cut instead of animating.\\n        self.buf = new\\n        self.line = line\\n        self.slide = 0\\n        self.armed_for = None\\n        self._plan_lyrics(now)\\n        self.dirty_full = True\\n\\n    def _start_slide(self, now):\\n        if not self.buf[1]:\\n            return False\\n        self._build_disp()\\n        # The page on screen can use up to four rows; the block moves by all\\n        # of them so the next line lands at the top.\\n        self.slide_px = min(self.MAX_ROWS, self.cur_rows) * self.slot_h\\n        self.slide = 1\\n        self.slide_at = now\\n        self.pos = 0\\n        self.dir = 1\\n        self.dirty_full = True\\n        return True\\n\\n    def _land(self, now):\\n        self.buf = (self.buf[1], self.buf[2], \\\"\\\")\\n        self.line = self.buf[0]\\n        self.slide = 0\\n        self._plan_lyrics(now)\\n        self.dirty_full = True\\n\\n    def _plan_lyrics(self, now):\\n        self._build_disp()\\n        self.page_at = now\\n        self.long = False\\n        self.max_off = 0\\n        self.pos = 0\\n        self.dir = 1\\n        self.frame_at = now\\n        self.hold_until = time.ticks_add(now, self.LYRIC_HOLD_MS)\\n        self.step = 1\\n\\n    # -- lyric wrapping ----------------------------------------------\\n    def _wrap(self, s, limit=None, size=None):\\n        \\\"\\\"\\\"Rows for one lyric line, measured at the scale that will draw it.\\\"\\\"\\\"\\n        if limit is None:\\n            limit = self.MAX_WRAP\\n        if size is None:\\n            size = getattr(self, \\\"txt\\\", self.TXT)\\n        s = (s or \\\"\\\").strip()\\n        if not s:\\n            return ()\\n        try:\\n            LCD.setTextSize(size)\\n        except Exception:\\n            pass\\n        maxw = W - 12\\n        rows = []\\n        row = \\\"\\\"\\n        try:\\n            for atom in _atoms(s):\\n                if not row and atom == \\\" \\\":\\n                    continue\\n                if tw(row + atom, F_JA) <= maxw:\\n                    row += atom\\n                    continue\\n                if row.strip():\\n                    rows.append(row.strip())\\n                    row = \\\"\\\"\\n                    if len(rows) >= limit:\\n                        return tuple(rows)\\n                if atom == \\\" \\\":\\n                    continue\\n                # A single word wider than the panel: split it by characters.\\n                for ch in atom:\\n                    if row and tw(row + ch, F_JA) > maxw:\\n                        rows.append(row)\\n                        row = \\\"\\\"\\n                        if len(rows) >= limit:\\n                            return tuple(rows)\\n                    row += ch\\n            if row.strip() and len(rows) < limit:\\n                rows.append(row.strip())\\n        finally:\\n            try:\\n                LCD.setTextSize(1)\\n            except Exception:\\n                pass\\n        return tuple(rows[:limit])\\n\\n    def _build_disp(self):\\n        # Every lyric row uses the same mid-size font and pitch, so the block\\n        # never changes shape from one line to the next.  A line that wraps\\n        # continues on the next row; only a line longer than four rows is\\n        # paged, and the pages keep the words in reading order.\\n        self.txt, self.slot_h = self.TXT, self.SLOT_H\\n        self.w_cur = self._wrap(self.buf[0], self.MAX_WRAP, self.txt)\\n        self.w_next = self._wrap(self.buf[1], self.MAX_WRAP, self.txt)\\n        self.w_n2 = self._wrap(self.buf[2], self.MAX_WRAP, self.txt)\\n        self.line_rows = len(self.w_cur)\\n        pages = (self.line_rows + self.MAX_ROWS - 1) // self.MAX_ROWS\\n        pages = pages or 1\\n        # A different sung line starts on page 0; re-reading the same line\\n        # must keep the page that is already on screen.\\n        if self.page_line != self.buf[0]:\\n            self.page_line = self.buf[0]\\n            self.line_page = 0\\n        elif self.line_page >= pages:\\n            self.line_page = pages - 1\\n        self.line_pages = pages\\n        start = self.line_page * self.MAX_ROWS\\n        rows = self.w_cur[start:start + self.MAX_ROWS]\\n        disp = list(rows)\\n        # Only the last page leaves room for the coming lines.  A page of the\\n        # line being sung always fits completely above the progress strip.\\n        if self.line_page == pages - 1:\\n            room = self.MAX_ROWS - len(disp)\\n            if room > 0:\\n                disp += self.w_next[:room]\\n                room = self.MAX_ROWS - len(disp)\\n            if room > 0:\\n                disp += self.w_n2[:room]\\n        self.disp = tuple(disp)\\n        self.cur_rows = len(rows) or 1\\n        self._page_ms()\\n\\n    def _page_ms(self):\\n        \\\"\\\"\\\"How long to hold one page: spread it over the line's duration.\\\"\\\"\\\"\\n        ms = self.PAGE_MS\\n        if self.line_pages > 1:\\n            ly = self.app.hub.ly or {}\\n            try:\\n                span = int(ly.get(\\\"next_at\\\")) - int(ly.get(\\\"line_at\\\"))\\n            except Exception:\\n                span = 0\\n            if span > 0:\\n                ms = span // self.line_pages\\n        self.page_ms = max(self.PAGE_MIN_MS,\\n                           min(self.PAGE_MAX_MS, int(ms)))\\n\\n    def _plan(self, d):\\n        self.max_off = 0\\n        self.step = 1\\n        for s, f in self._lines(d):\\n            w = tw(s, f)\\n            if w > W - 12 and w - (W - 12) > self.max_off:\\n                self.max_off = w - (W - 12)\\n        self.long = self.max_off > 0\\n\\n    def _lines(self, d):\\n        return ((d.get(\\\"song\\\") or \\\"-\\\", F_JA),\\n                (d.get(\\\"artist\\\") or \\\"-\\\", F_JA),\\n                (\\\"ON \\\" + (d.get(\\\"device\\\") or \\\"-\\\"), F_TINY))\\n\\n    def tick(self, now):\\n        # Re-align with the live playback position every few seconds.\\n        if self.lyrics:\\n            self._sync_tick(now)\\n\\n        redraw = self.refresh(now)\\n\\n        # An extra-long line is paged through so no row is cut off.\\n        if (self.lyrics and not self.slide and self.line_pages > 1\\n                and self.line_page < self.line_pages - 1\\n                and time.ticks_diff(now, self.page_at) >= self.page_ms):\\n            self.line_page += 1\\n            self.page_at = now\\n            self._build_disp()\\n            self.dirty_lines = True\\n            redraw = True\\n\\n        # Start the slide a moment before the next line so it lands on time\\n        # instead of reacting to a hub update that arrives late.\\n        if self.lyrics and not self.slide and self.buf[1]:\\n            na = (self.app.hub.ly or {}).get(\\\"next_at\\\")\\n            if na and na != self.armed_for:\\n                remain = int(na) - self._pos()\\n                if 0 < remain <= self.SLIDE_MS:\\n                    self.armed_for = na\\n                    self._start_slide(now)\\n\\n        if self.slide:\\n            el = time.ticks_diff(now, self.slide_at)\\n            if el >= self.SLIDE_MS:\\n                self._land(now)\\n            else:\\n                t = el / self.SLIDE_MS\\n                # ease out: the block settles instead of stopping dead\\n                self.slide = int(self.slide_px\\n                                 * (1.0 - (1.0 - t) * (1.0 - t)))\\n                if self.slide < 1:\\n                    self.slide = 1\\n                self.dirty_lines = True\\n            self.animating = True\\n            return True\\n\\n        # Lyrics never scroll sideways: rows are wrapped instead.\\n        if not self.long or self.lyrics:\\n            self.animating = False\\n            return redraw\\n        self.animating = True\\n        frame = self.LYRIC_FRAME_MS if self.lyrics else self.FRAME_MS\\n        if time.ticks_diff(now, self.frame_at) < frame:\\n            return redraw\\n        self.frame_at = now\\n        hold = self.LYRIC_HOLD_MS if self.lyrics else self.HOLD_MS\\n        moved = False\\n        if time.ticks_diff(now, self.hold_until) >= 0:\\n            self.pos += self.dir * self.step\\n            if self.pos >= self.max_off:\\n                self.pos = self.max_off\\n                self.dir = -1\\n                self.hold_until = time.ticks_add(now, hold)\\n            elif self.pos <= 0:\\n                self.pos = 0\\n                self.dir = 1\\n                self.hold_until = time.ticks_add(now, hold)\\n            moved = True\\n        if moved:\\n            self.dirty_lines = True\\n        return redraw or moved\\n\")\n_w(\"desk/spotdraw.py\", \"\\\"\\\"\\\"Spotify page renderer: song rows, sliding lyrics and progress.\\\"\\\"\\\"\\nfrom desk.ui import ACCENT, AMBER, BLACK, F_JA, F_SM, F_TINY, GREEN, LCD, LINE, MUTED, RED, SKY, W, WHITE, bar, ctext, dots, header, mmss, rtext, t1, tl, tw\\n\\n\\nclass SpotDraw:\\n    FRAME_MS = 33\\n    LYRIC_FRAME_MS = 15      # fast lyric scrolling frame rate\\n    LYRIC_STEP = 4           # 4 px/frame = ~266 px/s\\n    LYRIC_STEP_MAX = 8\\n    LYRIC_HOLD_MS = 300      # pause at each end of a lyric line\\n    HOLD_MS = 1000\\n    BAND_Y, BAND_H = 21, 69\\n    PROG_Y, PROG_H = 90, 32\\n\\n    # Lyrics are a teleprompter with one fixed size, so the rows never jump or\\n    # change shape between lines.  Every row uses mid-size (0.7) text on a 17 px\\n    # pitch; four rows fit in the band.  A line that is longer than the panel\\n    # continues on the following rows (never clipped mid-sentence), and a line\\n    # that needs more than four rows is paged through over time.\\n    SLOT_Y = 22\\n    SLOT_H = 17\\n    TXT = 0.7\\n    MAX_ROWS = 4\\n    MAX_WRAP = 40            # safety cap; a long line pages instead of clipping\\n    SLIDE_MS = 260\\n    SYNC_MS = 4000           # direct lyric alignment with live Spotify position\\n    PAGE_MS = 2400           # hold one page of an extra-long line\\n    PAGE_MIN_MS = 1400\\n    PAGE_MAX_MS = 3000\\n\\n    def _scroll(self, s, f, y, c, center=True):\\n        w = tw(s, f)\\n        if w <= W - 12:\\n            x = (W - w) // 2 if center else 6\\n            t1(s, f, x, y, c)\\n            return\\n        off = min(self.pos, w - (W - 12))\\n        t1(s, f, 6 - off, y, c)\\n\\n    def draw(self):\\n        if self.dirty_full:\\n            self.dirty_full = False\\n            self.dirty_lines = False\\n            self.dirty_prog = False\\n            self._draw_full()\\n            return\\n        if self.dirty_lines:\\n            self.dirty_lines = False\\n            self._draw_lines()\\n        if self.dirty_prog:\\n            self.dirty_prog = False\\n            self._draw_prog()\\n\\n    def _chrome(self):\\n        \\\"\\\"\\\"Header and dots.  The slide can push text into the top strip.\\\"\\\"\\\"\\n        app = self.app\\n        header(\\\"SPOTIFY\\\", app.idx, len(app.page_list()),\\n               GREEN if app.hub.playing() else ACCENT)\\n        dots(len(app.page_list()), app.idx)\\n\\n    def _draw_full(self):\\n        app = self.app\\n        d = app.hub.sp\\n        LCD.fillScreen(BLACK)\\n        if not d or isinstance(self.sig, str):\\n            self._chrome()\\n            ctext(\\\"SPOTIFY\\\", F_SM, 34, MUTED)\\n            ctext(self.sig if isinstance(self.sig, str)\\n                  else \\\"HUB OFFLINE\\\", F_TINY, 54, RED)\\n            ctext(\\\"hold 3s: back\\\", F_TINY, 104, MUTED)\\n            return\\n        st = d.get(\\\"status\\\")\\n        if st not in (\\\"success\\\", \\\"not_playing\\\", \\\"paused\\\"):\\n            self._chrome()\\n            ctext(\\\"SPOTIFY\\\", F_SM, 34, MUTED)\\n            ctext((d.get(\\\"message\\\") or st or \\\"ERROR\\\")[:22], F_TINY, 54, RED)\\n            ctext(\\\"hold 3s: back\\\", F_TINY, 104, MUTED)\\n            return\\n        self._draw_lines()\\n        self._draw_prog()\\n        self._chrome()\\n\\n    def _draw_lines(self):\\n        LCD.fillRect(0, self.BAND_Y, W, self.BAND_H, BLACK)\\n        d = self.app.hub.sp\\n        if not d:\\n            return\\n        if self.lyrics:\\n            self._draw_lyrics()\\n            # The block slides through the band edges, so paint the strips it\\n            # ran over: header on top, progress bar below.\\n            LCD.fillRect(0, 0, W, self.BAND_Y, BLACK)\\n            LCD.fillRect(0, self.PROG_Y, W, self.PROG_H, BLACK)\\n            self._chrome()\\n            self._draw_prog()\\n            return\\n        song, artist, dev = self._lines(d)\\n        self._scroll(song[0], song[1], 22, WHITE)\\n        self._scroll(artist[0], artist[1], 47, MUTED)\\n        if tw(dev[0], dev[1]) > W - 12:\\n            self._scroll(dev[0], dev[1], 73, ACCENT)\\n        else:\\n            t1(\\\"ON\\\", F_TINY, 6, 73, LINE)\\n            t1(dev[0][3:][:16], F_TINY, 24, 73, ACCENT)\\n\\n    def _draw_lyrics(self):\\n        d = self.app.hub.ly or {}\\n        st = d.get(\\\"status\\\")\\n        if st != \\\"success\\\":\\n            if st in (None, \\\"loading\\\"):\\n                ctext(\\\"FETCHING...\\\", F_SM, 42, MUTED)\\n            elif st == \\\"not_found\\\":\\n                ctext(\\\"NO LYRICS\\\", F_SM, 38, MUTED)\\n                ctext(\\\"hold 1s to hide\\\", F_TINY, 58, LINE)\\n            else:\\n                ctext(\\\"LYRICS ERROR\\\", F_SM, 38, RED)\\n                ctext((d.get(\\\"message\\\") or \\\"\\\")[:18], F_TINY, 58, MUTED)\\n            return\\n        disp = getattr(self, \\\"disp\\\", ())\\n        if not disp:\\n            ctext(\\\"...\\\", F_JA, 34, LINE)\\n            return\\n        rows = getattr(self, \\\"cur_rows\\\", 1)\\n        slot = getattr(self, \\\"slot_h\\\", self.SLOT_H)\\n        try:\\n            for k in range(len(disp)):\\n                yy = self.SLOT_Y - self.slide + k * slot\\n                # Keep the whole glyph row above the progress strip.\\n                if yy + slot - 2 > self.PROG_Y:\\n                    break\\n                if yy + slot > self.BAND_Y:\\n                    # Sung rows are white; the coming lines are sky blue.\\n                    self._lyric_row(disp[k], yy, WHITE if k < rows else SKY)\\n        finally:\\n            # Only lyrics are small: restore the scale for the header,\\n            # progress text and every page drawn after this one.\\n            try:\\n                LCD.setTextSize(1)\\n            except Exception:\\n                pass\\n\\n    def _lyric_row(self, s, y, c):\\n        # Font first, then the size: setFont can reset the scale on some\\n        # builds, so the order matters.\\n        LCD.setFont(F_JA)\\n        try:\\n            LCD.setTextSize(getattr(self, \\\"txt\\\", self.TXT))\\n        except Exception:\\n            pass\\n        LCD.setTextColor(c, BLACK)\\n        LCD.drawString(s, 6, int(y))\\n\\n    def _draw_prog(self):\\n        d = self.app.hub.sp\\n        if not d:\\n            return\\n        LCD.fillRect(0, self.PROG_Y, W, self.PROG_H, BLACK)\\n        playing = self.app.hub.playing()\\n        dur = int(d.get(\\\"duration_ms\\\") or 0)\\n        pos = self._pos()\\n        pct = (pos * 100 // dur) if dur else 0\\n        bar(6, self.PROG_Y + 1, 116, 5, pct, GREEN if playing else AMBER)\\n        tl(mmss(pos), F_TINY, 6, self.PROG_Y + 8, MUTED)\\n        rtext(mmss(dur), F_TINY, 122, self.PROG_Y + 8, MUTED)\\n        ctext(\\\"PLAYING\\\" if playing else \\\"PAUSED\\\", F_TINY, self.PROG_Y + 20,\\n              GREEN if playing else AMBER)\\n\")\n_w(\"desk/ui.py\", \"\\\"\\\"\\\"Palette, fonts and drawing helpers for the 128x128 panel.\\\"\\\"\\\"\\nimport M5\\n\\nLCD = M5.Display\\nF = M5.Lcd.FONTS\\nF_TINY = F.DejaVu9\\nF_SM = F.DejaVu12\\nF_MD = F.DejaVu18\\nF_BIG = F.DejaVu40\\ntry:\\n    F_JA = F.EFontJA24\\nexcept Exception:\\n    F_JA = F_MD\\n\\nW = 128\\nH = 128\\n\\nBLACK = 0x000000\\nPANEL = 0x101820\\nGHOST = 0x151F29\\nLINE = 0x22303C\\nWHITE = 0xE6EDF3\\nMUTED = 0x7D8590\\nACCENT = 0x22D3EE\\nACCENT2 = 0xF472B6\\nSKY = 0x38BDF8\\nGREEN = 0x3FB950\\nAMBER = 0xD29922\\nORANGE = 0xF0883E\\nYELLOW = 0xE3B341\\nRED = 0xF85149\\nPURPLE = 0xA78BFA\\n\\n# Index order shared with the hub's ui page builder.\\nPAL = (BLACK, PANEL, GHOST, LINE, WHITE, MUTED, ACCENT, ACCENT2,\\n       GREEN, AMBER, ORANGE, YELLOW, RED, PURPLE)\\n\\nWD = (\\\"MON\\\", \\\"TUE\\\", \\\"WED\\\", \\\"THU\\\", \\\"FRI\\\", \\\"SAT\\\", \\\"SUN\\\")\\nMON = (\\\"JAN\\\", \\\"FEB\\\", \\\"MAR\\\", \\\"APR\\\", \\\"MAY\\\", \\\"JUN\\\",\\n       \\\"JUL\\\", \\\"AUG\\\", \\\"SEP\\\", \\\"OCT\\\", \\\"NOV\\\", \\\"DEC\\\")\\n\\n\\ndef pc(ci, default=WHITE):\\n    try:\\n        return PAL[ci]\\n    except Exception:\\n        return default\\n\\n\\n# ------------------------------------------------------------------ drawing\\ndef tl(s, f, x, y, c=WHITE, bg=BLACK):\\n    LCD.setFont(f)\\n    try:\\n        # Normal text is always full size; only the lyric rows set a scale.\\n        LCD.setTextSize(1)\\n    except Exception:\\n        pass\\n    LCD.setTextColor(c, bg)\\n    LCD.setCursor(int(x), int(y))\\n    LCD.print(s)\\n\\n\\ndef t1(s, f, x, y, c=WHITE, bg=BLACK):\\n    LCD.setFont(f)\\n    try:\\n        LCD.setTextSize(1)\\n    except Exception:\\n        pass\\n    LCD.setTextColor(c, bg)\\n    LCD.drawString(s, int(x), int(y))\\n\\n\\ndef tw(s, f):\\n    return LCD.textWidth(s, f)\\n\\n\\ndef ctext(s, f, y, c=WHITE, bg=BLACK):\\n    tl(s, f, (W - tw(s, f)) // 2, y, c, bg)\\n\\n\\ndef rtext(s, f, xr, y, c=WHITE, bg=BLACK):\\n    tl(s, f, xr - tw(s, f), y, c, bg)\\n\\n\\ndef temp(s, f, x, y, c=WHITE, bg=BLACK, r=2):\\n    w = tw(s, f)\\n    tl(s, f, x, y, c, bg)\\n    cx = x + w + r + 1\\n    cy = y + r + 2\\n    LCD.drawCircle(cx, cy, r, c)\\n    LCD.fillCircle(cx, cy, r - 1, bg)\\n    tl(\\\"C\\\", f, cx + r + 2, y, c, bg)\\n\\n\\ndef ctemp(s, f, y, c=WHITE, bg=BLACK, r=2):\\n    w = tw(s, f) + 2 * r + 3 + tw(\\\"C\\\", f)\\n    temp(s, f, (W - w) // 2, y, c, bg, r)\\n\\n\\ndef rtemp(s, f, xr, y, c=WHITE, bg=BLACK, r=2):\\n    w = tw(s, f) + 2 * r + 3 + tw(\\\"C\\\", f)\\n    temp(s, f, xr - w, y, c, bg, r)\\n\\n\\ndef bar(x, y, w, h, pct, c, bg=LINE):\\n    if pct < 0:\\n        pct = 0\\n    if pct > 100:\\n        pct = 100\\n    LCD.fillRect(int(x), int(y), int(w), int(h), bg)\\n    fw = int(w * pct / 100)\\n    if fw > 0:\\n        LCD.fillRect(int(x), int(y), fw, int(h), c)\\n\\n\\ndef header(title, idx, n, c=ACCENT):\\n    tl(title, F_SM, 6, 5, c)\\n    rtext(\\\"%d/%d\\\" % (idx + 1, n), F_TINY, 122, 7, MUTED)\\n    LCD.fillRect(0, 20, W, 1, LINE)\\n\\n\\ndef dots(n, idx, y=122):\\n    total = n * 6 - 2\\n    x = (W - total) // 2\\n    for i in range(n):\\n        LCD.fillRect(x + i * 6, y, 4, 4, ACCENT if i == idx else LINE)\\n\\n\\nSEGMENTS = {\\n    \\\"0\\\": \\\"abcdef\\\", \\\"1\\\": \\\"bc\\\", \\\"2\\\": \\\"abdeg\\\", \\\"3\\\": \\\"abcdg\\\", \\\"4\\\": \\\"bcfg\\\",\\n    \\\"5\\\": \\\"acdfg\\\", \\\"6\\\": \\\"acdefg\\\", \\\"7\\\": \\\"abc\\\", \\\"8\\\": \\\"abcdefg\\\", \\\"9\\\": \\\"abcdfg\\\",\\n}\\n\\n\\ndef _seg_rects(x, y, w, h, t):\\n    hw = (h - 3 * t) // 2\\n    return {\\n        \\\"a\\\": (x + t, y, w - 2 * t, t),\\n        \\\"b\\\": (x + w - t, y + t, t, hw),\\n        \\\"c\\\": (x + w - t, y + 2 * t + hw, t, hw),\\n        \\\"d\\\": (x + t, y + h - t, w - 2 * t, t),\\n        \\\"e\\\": (x, y + 2 * t + hw, t, hw),\\n        \\\"f\\\": (x, y + t, t, hw),\\n        \\\"g\\\": (x + t, y + t + hw, w - 2 * t, t),\\n    }\\n\\n\\ndef seg_time(s, y, c=WHITE, ghost=GHOST):\\n    dw, dh, t, gap, cw = 24, 46, 5, 5, 8\\n    x = (W - (4 * dw + cw + 4 * gap)) // 2\\n    for i, ch in enumerate(s):\\n        if i == 2:\\n            LCD.fillRect(x + 1, y + 14, 5, 5, c)\\n            LCD.fillRect(x + 1, y + 28, 5, 5, c)\\n            x += cw + gap\\n        rects = _seg_rects(x, y, dw, dh, t)\\n        for k in \\\"abcdefg\\\":\\n            r = rects[k]\\n            LCD.fillRect(r[0], r[1], r[2], r[3], ghost)\\n        for k in SEGMENTS.get(ch, \\\"\\\"):\\n            r = rects[k]\\n            LCD.fillRect(r[0], r[1], r[2], r[3], c)\\n        x += dw + gap\\n\\n\\ndef wrap(s, f, max_w, max_lines=3):\\n    out = []\\n    for para in str(s).split(\\\"\\\\n\\\"):\\n        line = \\\"\\\"\\n        for word in para.split(\\\" \\\"):\\n            while word and tw(word, f) > max_w:\\n                cut = len(word)\\n                while cut > 1 and tw(word[:cut], f) > max_w:\\n                    cut -= 1\\n                if line:\\n                    out.append(line)\\n                    line = \\\"\\\"\\n                out.append(word[:cut])\\n                word = word[cut:]\\n                if len(out) >= max_lines:\\n                    return out\\n            cand = word if not line else line + \\\" \\\" + word\\n            if line and tw(cand, f) > max_w:\\n                out.append(line)\\n                line = word\\n            else:\\n                line = cand\\n            if len(out) >= max_lines:\\n                return out\\n        if line or not para.split(\\\" \\\"):\\n            out.append(line)\\n        if len(out) >= max_lines:\\n            return out\\n    return out[:max_lines]\\n\\n\\ndef atom_face(mood=\\\"normal\\\", dev=0, alert=False):\\n    ey = 42 + dev\\n    for ex in (32, W - 32):\\n        if mood == \\\"blink\\\":\\n            LCD.fillRect(ex - 5, ey - 1, 10, 3, WHITE)\\n        elif mood == \\\"happy\\\":\\n            LCD.fillArc(ex, ey, 8, 4, 180, 360, WHITE)\\n        elif mood == \\\"sleep\\\":\\n            LCD.fillArc(ex, ey, 8, 4, 0, 180, WHITE)\\n        else:\\n            LCD.fillCircle(ex, ey, 6, WHITE)\\n    LCD.fillRect(40, 91, 48, 4, WHITE)\\n    if alert:\\n        LCD.fillRect(118, 24, 5, 18, RED)\\n        LCD.fillRect(118, 46, 5, 5, RED)\\n\\n\\ndef splash(sub=\\\"thin display - hub driven\\\"):\\n    LCD.fillScreen(BLACK)\\n    LCD.fillRect(16, 42, 3, 64, ACCENT)\\n    tl(\\\"ATOM\\\", F_SM, 27, 38, MUTED)\\n    tl(\\\"DESK\\\", F_BIG, 26, 50, WHITE)\\n    tl(sub, F_TINY, 27, 96, MUTED)\\n    tl(\\\"starting...\\\", F_TINY, 27, 116, ACCENT)\\n\\n\\ndef splash_line(text, color=ACCENT):\\n    \\\"\\\"\\\"Redraw only the splash status line (used while joining Wi-Fi).\\\"\\\"\\\"\\n    LCD.fillRect(0, 110, W, 18, BLACK)\\n    t1(text[:22], F_TINY, 27, 114, color)\\n\\n\\ndef age_text(sec):\\n    if sec < 60:\\n        return \\\"NOW\\\"\\n    if sec < 3600:\\n        return \\\"%dm\\\" % (sec // 60)\\n    if sec < 86400:\\n        return \\\"%dh%02dm\\\" % (sec // 3600, (sec % 3600) // 60)\\n    return \\\"%dd%02dh\\\" % (sec // 86400, (sec % 86400) // 3600)\\n\\n\\ndef mmss(ms):\\n    s = int(ms or 0) // 1000\\n    return \\\"%d:%02d\\\" % (s // 60, s % 60)\\n\")\n_w(\"desk/wifi.py\", \"\\\"\\\"\\\"Wi-Fi roaming: scan for known networks, home first, then the rest.\\\"\\\"\\\"\\nimport json\\nimport time\\nfrom desk.const import HOME_AFTER_MS, ROAM_AFTER_MS\\n\\n# ------------------------------------------------------------------- config\\ndef load_cfg():\\n    try:\\n        f = open(\\\"/flash/config.json\\\")\\n        try:\\n            return json.load(f)\\n        finally:\\n            f.close()\\n    except Exception:\\n        return {}\\n\\n\\ndef _nets(cfg):\\n    w = cfg.get(\\\"wifi\\\")\\n    if isinstance(w, dict) and isinstance(w.get(\\\"networks\\\"), list):\\n        w = w[\\\"networks\\\"]\\n    elif isinstance(w, dict):\\n        w = [w]\\n    elif not isinstance(w, list):\\n        w = []\\n    out = []\\n    for n in w:\\n        if isinstance(n, dict) and n.get(\\\"ssid\\\"):\\n            out.append((n[\\\"ssid\\\"], n.get(\\\"password\\\") or \\\"\\\"))\\n    return out\\n\\n\\n# --------------------------------------------------------------------- wifi\\nclass Wifi:\\n    SCAN_MS = 12000          # re-scan visible APs at most this often\\n\\n    def __init__(self, wlan, cfg):\\n        self.wlan = wlan\\n        self.nets = _nets(cfg)\\n        self.idx = 0\\n        self.home = self.nets[0][0] if self.nets else \\\"\\\"\\n        self.ssid = \\\"\\\"\\n        self.try_ssid = \\\"\\\"\\n        self.out_at = 0\\n        self.foreign_at = 0\\n        self.next_try = time.ticks_ms()\\n        self.fail = 0\\n        self.err = \\\"\\\"\\n        self.vis = None           # visible SSID -> RSSI from the last scan\\n        self.scan_at = time.ticks_add(time.ticks_ms(), -self.SCAN_MS)\\n        self._radio()\\n\\n    def _radio(self):\\n        w = self.wlan\\n        try:\\n            if not w.active():\\n                w.active(True)\\n        except Exception as e:\\n            self.err = \\\"act \\\" + str(e)[:16]\\n            return\\n        try:\\n            w.config(pm=0)            # no power save: weak APs stall otherwise\\n        except Exception:\\n            pass\\n        try:\\n            w.config(reconnects=0)    # this loop owns reconnects\\n        except Exception:\\n            pass\\n        try:\\n            w.config(protocol=3)      # 11b/g only, no HT aggregation\\n        except Exception:\\n            pass\\n        try:\\n            w.config(txpower=10.0)\\n        except Exception:\\n            pass\\n\\n    def up(self):\\n        try:\\n            return bool(self.wlan.isconnected())\\n        except Exception:\\n            return False\\n\\n    def _scan(self, now, force=False):\\n        \\\"\\\"\\\"Visible SSIDs and their signal, or None when scanning is unsupported.\\\"\\\"\\\"\\n        if not force and self.vis is not None:\\n            if time.ticks_diff(now, self.scan_at) < self.SCAN_MS:\\n                return self.vis\\n        self.scan_at = now\\n        try:\\n            rows = self.wlan.scan()\\n        except Exception:\\n            self.vis = None\\n            return None\\n        vis = {}\\n        for row in rows or ():\\n            try:\\n                ssid = row[0]\\n                if isinstance(ssid, bytes):\\n                    ssid = ssid.decode()\\n                if not ssid:\\n                    continue\\n                rssi = int(row[3])\\n            except Exception:\\n                continue\\n            if ssid not in vis or rssi > vis[ssid]:\\n                vis[ssid] = rssi\\n        self.vis = vis\\n        return vis\\n\\n    def _order(self, now, force=False):\\n        \\\"\\\"\\\"Known networks to try: home first when visible, then the strongest.\\n\\n        Returns None when the radio cannot scan, so the caller can fall back\\n        to cycling the configured list.\\n        \\\"\\\"\\\"\\n        vis = self._scan(now, force)\\n        if vis is None:\\n            return None\\n        out = []\\n        if self.home and self.home in vis:\\n            for n in self.nets:\\n                if n[0] == self.home:\\n                    out.append(n)\\n                    break\\n        rest = [n for n in self.nets if n[0] != self.home and n[0] in vis]\\n        rest.sort(key=lambda n: vis.get(n[0], -999), reverse=True)\\n        out += rest\\n        if not out:\\n            # The AP may be hidden from the scan; still try what we know.\\n            return list(self.nets)\\n        return out\\n\\n    def poll(self, now, hub_ok):\\n        up = self.up()\\n        if up:\\n            self.out_at = 0\\n            self.fail = 0\\n            if self.try_ssid:\\n                self.try_ssid = \\\"\\\"\\n                self.idx = 0\\n                self.vis = None    # next drop gets a fresh scan\\n            if self.home and self.ssid and self.ssid != self.home:\\n                # a travel AP took us; if the hub is unreachable, go home\\n                if not self.foreign_at:\\n                    self.foreign_at = now\\n                elif (not hub_ok and\\n                      time.ticks_diff(now, self.foreign_at) > HOME_AFTER_MS):\\n                    self.foreign_at = 0\\n                    vis = self._scan(now, force=True)\\n                    if vis is None or self.home in vis:\\n                        self.idx = 0\\n                        self.ssid = self.home\\n                        self.next_try = time.ticks_add(now, 2000)\\n                        try:\\n                            self.wlan.disconnect()\\n                        except Exception:\\n                            pass\\n                    else:\\n                        # home is not in range: stay on the working AP\\n                        self.next_try = time.ticks_add(now, 30000)\\n            else:\\n                self.foreign_at = 0\\n        else:\\n            if not self.out_at:\\n                self.out_at = now\\n                self.foreign_at = 0\\n            if time.ticks_diff(now, self.next_try) >= 0:\\n                self._connect(now)\\n        return up\\n\\n    def _connect(self, now):\\n        self.next_try = time.ticks_add(now, 3000)\\n        if not self.nets:\\n            return\\n        try:\\n            if not self.wlan.active():\\n                self._radio()\\n                return\\n            st = self.wlan.status()\\n        except Exception as e:\\n            self.err = \\\"st \\\" + str(e)[:14]\\n            self.next_try = time.ticks_add(now, 30000)\\n            return\\n        if st in (1001, 1010):\\n            self.fail = 0\\n            self.next_try = time.ticks_add(now, 1500)\\n            return\\n        nets = self._order(now)\\n        if nets is None:\\n            nets = self.nets\\n            if self.out_at and time.ticks_diff(now, self.out_at) < ROAM_AFTER_MS:\\n                nets = nets[:1]       # no scan support: stay home first\\n        if not nets:\\n            return\\n        if self.idx >= len(nets):\\n            self.idx = 0\\n        ssid, pw = nets[self.idx]\\n        try:\\n            if pw:\\n                self.wlan.connect(ssid, pw)\\n            else:\\n                self.wlan.connect(ssid)\\n            self.ssid = ssid\\n            self.try_ssid = ssid\\n            self.err = \\\"\\\"\\n            self.fail = 0\\n            self.idx = (self.idx + 1) % len(nets)\\n            self.next_try = time.ticks_add(now, 5000)\\n        except Exception as e:\\n            self.err = \\\"wifi \\\" + str(e)[:14]\\n            self.fail += 1\\n            self.idx = (self.idx + 1) % len(nets)\\n            if self.fail >= 5:\\n                self.fail = 0\\n                try:\\n                    self.wlan.active(False)\\n                except Exception:\\n                    pass\\n                time.sleep_ms(300)\\n                self._radio()\\n                self.next_try = time.ticks_add(now, 10000)\\n            else:\\n                self.next_try = time.ticks_add(now, 6000)\\n\")\n\ndel _w, _mk\n\n# Same entry point as the standalone firmware (desk.app.run calls M5.begin).\nimport app\n\napp.run(wlan)\n","customList":[]}
